---
/**
 * LA CASA — presentación detallada de la propiedad.
 *
 * Sólo se publica lo verificado en las fotografías reales. Capacidad, número
 * de dormitorios y baños, horarios y tarifa se confirman por WhatsApp hasta
 * que el propietario los facilite (ver `src/config/site.ts`).
 */
import AmenityGrid from '../components/amenities/AmenityGrid.astro';
import WhatsAppButton from '../components/booking/WhatsAppButton.astro';
import PropertyImage from '../components/media/PropertyImage.astro';
import GallerySection from '../components/sections/GallerySection.astro';
import SpacesSection from '../components/sections/SpacesSection.astro';
import Chapter from '../components/ui/Chapter.astro';
import Container from '../components/ui/Container.astro';
import Section from '../components/ui/Section.astro';
import { site } from '../config/site.js';
import { gallery, photoBySlug } from '../data/gallery.js';
import { propertyIntro } from '../data/property.js';
import PageLayout from '../layouts/PageLayout.astro';
import { getAmenities } from '../lib/services/content.service.js';

const amenities = (await getAmenities()).filter((amenity) => amenity.confirmed);
const pendingNames = (await getAmenities())
  .filter((amenity) => !amenity.confirmed)
  .map((amenity) => amenity.name.toLowerCase());

/** Interiores para el cierre: dormitorios, cocina y baños. */
const interiors = gallery.filter(
  (image) => image.category === 'dormitorios' || image.category === 'interiores',
);

/** Condiciones: se muestra el dato si existe; si no, cómo se confirma. */
const conditions = [
  { label: 'Check-in', value: site.booking.checkIn || 'Se coordina al reservar' },
  { label: 'Check-out', value: site.booking.checkOut || 'Se coordina al reservar' },
  {
    label: 'Estadía mínima',
    value: site.booking.minNights ? `${site.booking.minNights} noches` : 'Consultar según fechas',
  },
  { label: 'Tarifa', value: site.booking.priceRange || 'Según temporada y grupo' },
];

const breadcrumbs = [
  { name: 'Inicio', href: '/' },
  { name: 'La casa', href: '/casa' },
];
---

<PageLayout
  title="La casa: piscina, jardín y dormitorios en Ica"
  description="Conoce Casa Leblanc por dentro: casa vacacional de dos plantas en Ica con piscina iluminada, jardín, terraza, sala, cocina y dormitorios para familias y grupos."
  heading="Una casa completa en Ica, para tu grupo"
  eyebrow="La casa"
  intro="Dos plantas, piscina iluminada, jardín y dormitorios para familias y grupos. Así es Casa Leblanc por dentro y por fuera."
  breadcrumbs={breadcrumbs}
  image={photoBySlug('casa-leblanc-ica-fachada-piscina-noche')}
>
  <Section tone="default" container="none" aria-labelledby="descripcion-title">
    <Container size="wide">
      <div class="overview">
        <div class="overview__text">
          <Chapter
            index="01"
            eyebrow={propertyIntro.eyebrow}
            title={propertyIntro.title}
            id="descripcion-title"
            titleWidth="18ch"
          />
          <div class="prose">
            {propertyIntro.paragraphs.map((paragraph) => <p>{paragraph}</p>)}
          </div>

          <div class="overview__conditions">
            <h3 class="overview__conditions-title">Condiciones de la estadía</h3>
            <dl class="conditions">
              {
                conditions.map((item) => (
                  <div class="conditions__item">
                    <dt>{item.label}</dt>
                    <dd>{item.value}</dd>
                  </div>
                ))
              }
            </dl>
          </div>
        </div>

        <div class="overview__media">
          <PropertyImage
            image={photoBySlug('sala-de-estar-casa-leblanc')}
            ratio="4 / 5"
            sizes="(min-width: 64rem) 38vw, 92vw"
            class="overview__image"
          />
        </div>
      </div>
    </Container>
  </Section>

  <SpacesSection
    index="02"
    title="Exteriores, zonas comunes y dormitorios"
    description="Tres ambientes que definen la estadía en Casa Leblanc."
    showAction={false}
  />

  <Section id="equipamiento" tone="default" container="none" aria-labelledby="amenities-title">
    <Container size="wide">
      <Chapter
        index="03"
        eyebrow="Equipamiento"
        title="Lo que encontrarás en la casa"
        description="Equipamiento visible en las fotografías de la casa."
        id="amenities-title"
        titleWidth="18ch"
      />
      <AmenityGrid amenities={amenities} grouped columns={2} />

      <div class="ask">
        <p class="ask__text">
          ¿Necesitas confirmar algo más antes de reservar, como {pendingNames.slice(0, 4).join(', ')}
          u otro servicio? Pregúntanos y te respondemos con el detalle.
        </p>
        <WhatsAppButton variant="outline" message={`Hola, tengo una consulta sobre los servicios de ${site.name}.`} />
      </div>
    </Container>
  </Section>

  <GallerySection
    images={interiors}
    index="04"
    title="Dormitorios y baños"
    description="Camas matrimoniales, camarotes y camas individuales, y baños con ducha de mampara."
  />
</PageLayout>

<style>
  .ask {
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    justify-content: space-between;
    gap: var(--space-lg);
    margin-block-start: var(--space-3xl);
    padding: var(--space-xl);
    border: 1px solid var(--color-border);
    background-color: var(--color-surface-sand);
  }

  .ask__text {
    max-width: 60ch;
    color: var(--color-text-soft);
  }

  .overview {
    display: grid;
    gap: var(--space-2xl);
  }

  .overview__conditions {
    margin-block-start: var(--space-2xl);
    padding-block-start: var(--space-xl);
    border-block-start: 1px solid var(--color-border);
  }

  .overview__conditions-title {
    font-family: var(--font-body);
    font-size: var(--text-2xs);
    font-weight: var(--weight-semibold);
    letter-spacing: var(--tracking-widest);
    text-transform: uppercase;
    color: var(--color-text-muted);
  }

  .conditions {
    display: grid;
    grid-template-columns: repeat(2, minmax(0, 1fr));
    gap: var(--space-lg);
    margin-block-start: var(--space-md);
  }

  .conditions dt {
    font-size: var(--text-2xs);
    letter-spacing: var(--tracking-wide);
    text-transform: uppercase;
    color: var(--color-text-muted);
  }

  .conditions dd {
    margin: 0.3rem 0 0;
    font-family: var(--font-heading);
    font-size: 1.375rem;
    font-weight: var(--weight-heading);
    line-height: 1.25;
  }

  @media (min-width: 64rem) {
    .overview {
      grid-template-columns: minmax(0, 1.1fr) minmax(0, 0.9fr);
      gap: var(--space-4xl);
      align-items: start;
    }
  }
</style>
