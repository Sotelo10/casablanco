---
/**
 * PREGUNTAS FRECUENTES
 * Sólo las respuestas definitivas se publican como datos estructurados
 * (FAQPage); las pendientes se muestran en la página pero no se envían a los
 * buscadores.
 */
import FaqSection from '../components/sections/FaqSection.astro';
import PageLayout from '../layouts/PageLayout.astro';
import { faqSchema } from '../lib/seo/schema.js';
import { getFaqs, getPublishableFaqs } from '../lib/services/content.service.js';

const faqs = getFaqs();
const schema = faqSchema(getPublishableFaqs());

const breadcrumbs = [
  { name: 'Inicio', href: '/' },
  { name: 'Preguntas frecuentes', href: '/faq' },
];
---

<PageLayout
  title="Preguntas frecuentes sobre el alojamiento"
  description="Cómo reservar Casa Leblanc en Ica, qué espacios tiene la casa, dónde está y qué hacer cerca de Huacachina. Respuestas antes de tu estadía."
  heading="Preguntas frecuentes"
  eyebrow="Antes de reservar"
  intro="Las dudas más habituales antes de solicitar una reserva. Si falta alguna, escríbenos y te respondemos."
  breadcrumbs={breadcrumbs}
  schemas={[schema]}
>
  <FaqSection
    faqs={faqs}
    index="01"
    title="Todo lo que suelen preguntarnos"
    description="Si tu pregunta no está aquí, escríbenos por WhatsApp y te respondemos."
    tone="default"
  />

</PageLayout>
