---
/**
 * PORTADA
 * -----------------------------------------------------------------------------
 * Recorrido en capítulos numerados que alternan fondo para dar ritmo al scroll:
 *
 *   Hero (vídeo) → 01 la casa → 02 experiencias (arena) → 03 galería (azul) →
 *   04 servicios → 05 reservas (azul) → 06 ubicación → [opiniones] →
 *   preguntas → contacto (arena)
 *
 * Las opiniones sólo aparecen cuando existan reseñas reales: no se publican
 * opiniones de ejemplo. La numeración se ajusta sola.
 */
import Hero from '../components/hero/Hero.astro';
import BookingSection from '../components/sections/BookingSection.astro';
import ContactSection from '../components/sections/ContactSection.astro';
import FaqSection from '../components/sections/FaqSection.astro';
import GallerySection from '../components/sections/GallerySection.astro';
import HouseSection from '../components/sections/HouseSection.astro';
import LocationSection from '../components/sections/LocationSection.astro';
import ReviewsSection from '../components/sections/ReviewsSection.astro';
import ServicesSection from '../components/sections/ServicesSection.astro';
import StayExperiencesSection from '../components/sections/StayExperiencesSection.astro';
import { homeFaqIds } from '../data/faq.js';
import { heroPosterSrc, heroPosterSrcset } from '../data/hero.js';
import BaseLayout from '../layouts/BaseLayout.astro';
import { getFaqs, getFeaturedGallery } from '../lib/services/content.service.js';
import { getReviews, summarize } from '../lib/services/reviews.service.js';

const [featuredImages, reviews] = await Promise.all([getFeaturedGallery(5), getReviews()]);

const reviewSummary = summarize(reviews);
const hasRealReviews = reviews.length > 0 && !reviewSummary.isDemo;

const allFaqs = getFaqs();
const homeFaqs = homeFaqIds
  .map((id) => allFaqs.find((faq) => faq.id === id))
  .filter((faq): faq is NonNullable<typeof faq> => Boolean(faq));

/** Numeración de capítulos: las opiniones sólo cuentan si se muestran. */
const chapter = (() => {
  let n = 6;
  const next = () => String(++n).padStart(2, '0');
  return { reviews: hasRealReviews ? next() : '', faq: next(), contact: next() };
})();

const title = 'Casa Leblanc | Casa vacacional con piscina cerca de Huacachina, Ica';
const description =
  'Casa vacacional privada con piscina cerca de Huacachina, Ica. Alojamiento completo para familias, parejas y grupos. Consulta disponibilidad por WhatsApp.';
---

<BaseLayout
  title={title}
  description={description}
  isHome
  headerVariant="transparent"
  reviewSummary={reviewSummary}
  preloadImage={{ href: heroPosterSrc, srcset: heroPosterSrcset, sizes: '100vw' }}
>
  <Hero />

  <HouseSection index="01" />

  <StayExperiencesSection index="02" />

  <GallerySection
    images={featuredImages}
    index="03"
    title="Cada rincón, tal como es"
    description="Fotografías reales de la casa. Pulsa cualquier imagen para verla a pantalla completa."
  />

  <ServicesSection index="04" />

  <BookingSection index="05" />

  <LocationSection index="06" />

  {hasRealReviews && <ReviewsSection reviews={reviews} summary={reviewSummary} index={chapter.reviews} />}

  <FaqSection
    faqs={homeFaqs}
    index={chapter.faq}
    actionHref="/faq"
    actionLabel="Ver todas las preguntas"
  />

  <ContactSection index={chapter.contact} />
</BaseLayout>
