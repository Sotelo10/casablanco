---
/**
 * GALERÍA — mosaico editorial sobre tinta, con lightbox.
 */
import GallerySection from '../components/sections/GallerySection.astro';
import Badge from '../components/ui/Badge.astro';
import PlaceholderNotice from '../components/ui/PlaceholderNotice.astro';
import Container from '../components/ui/Container.astro';
import Section from '../components/ui/Section.astro';
import { galleryCategories } from '../data/gallery.js';
import PageLayout from '../layouts/PageLayout.astro';
import { getGallery } from '../lib/services/content.service.js';

const images = await getGallery();

const availableCategories = galleryCategories.filter((category) =>
  images.some((image) => image.category === category.id),
);

const breadcrumbs = [
  { name: 'Inicio', href: '/' },
  { name: 'Galería', href: '/galeria' },
];
---

<PageLayout
  title="Galería de fotos"
  description="Fotografías de Casa Blanco, casa vacacional en Ica: exteriores, sala, comedor, cocina, habitaciones, baños y zonas al aire libre."
  heading="La casa, ambiente por ambiente"
  eyebrow="Galería"
  intro="Los espacios de Casa Blanco, uno a uno. Pulsa cualquier imagen para verla a pantalla completa."
  breadcrumbs={breadcrumbs}
  ctaTopWave="deep"
>
  <ul class="categories" role="list" slot="header-extra">
    {
      availableCategories.map((category) => (
        <li>
          <Badge>{category.label}</Badge>
        </li>
      ))
    }
  </ul>

  <Section tone="default" container="none" size="compact">
    <Container size="wide">
      <PlaceholderNotice text="Las imágenes son placas con la proporción exacta de las fotografías definitivas. Al añadir los archivos reales en src/assets/property/ la galería se actualiza sola." />
    </Container>
  </Section>

  <GallerySection
    images={images}
    index="01"
    title="Recorrido completo"
    description="Exteriores, zonas comunes, dormitorios y áreas al aire libre."
    actionHref={null}
    actionLabel={null}
    priorityCount={2}
  />
</PageLayout>

<style>
  .categories {
    display: flex;
    flex-wrap: wrap;
    gap: var(--space-2xs);
    margin-block-start: var(--space-md);
    list-style: none;
    padding: 0;
  }
</style>
