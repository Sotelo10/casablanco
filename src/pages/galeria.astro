---
/**
 * GALERÍA — mosaico editorial sobre tinta, con lightbox.
 */
import GallerySection from '../components/sections/GallerySection.astro';
import Badge from '../components/ui/Badge.astro';
import { galleryCategories } from '../data/gallery.js';
import PageLayout from '../layouts/PageLayout.astro';
import { getGallery } from '../lib/services/content.service.js';

const images = await getGallery();

const availableCategories = galleryCategories.filter((category) =>
  images.some((image) => image.category === category.id),
);

const breadcrumbs = [
  { name: 'Inicio', href: '/' },
  { name: 'Galería', href: '/galeria' },
];
---

<PageLayout
  title="Galería de fotos de la casa vacacional en Ica"
  description="Fotos reales de Casa Leblanc en Ica: piscina iluminada, jardín, terraza, sala, cocina, dormitorios y baños de esta casa vacacional cerca de Huacachina."
  heading="Galería de Casa Leblanc"
  eyebrow="Galería"
  intro="Fotografías reales de la casa: exteriores, piscina, zonas comunes, dormitorios y baños. Pulsa cualquier imagen para verla a pantalla completa."
  breadcrumbs={breadcrumbs}
>
  <ul class="categories" role="list" slot="header-extra">
    {
      availableCategories.map((category) => (
        <li>
          <Badge>{category.label}</Badge>
        </li>
      ))
    }
  </ul>

  <GallerySection
    images={images}
    index="01"
    title="Recorrido completo por la casa"
    description={`${images.length} fotografías de los exteriores, la piscina, las zonas comunes, los dormitorios y los baños.`}
    actionHref={null}
    actionLabel={null}
    priorityCount={2}
  />
</PageLayout>

<style>
  .categories {
    display: flex;
    flex-wrap: wrap;
    gap: var(--space-2xs);
    margin-block-start: var(--space-md);
    list-style: none;
    padding: 0;
  }
</style>
