---
/**
 * EXPERIENCIA — Ica como destino, con Casa Leblanc como punto de partida.
 *
 * Página de contenido para búsquedas de turismo ("qué hacer en Ica", "dónde
 * alojarse en Ica", "alojamiento cerca de Huacachina"). Sólo información
 * general y comprobable de la región; ningún lugar se presenta como parte de
 * la propiedad.
 */
import ExperienceSection from '../components/sections/ExperienceSection.astro';
import StayExperiencesSection from '../components/sections/StayExperiencesSection.astro';
import Chapter from '../components/ui/Chapter.astro';
import Container from '../components/ui/Container.astro';
import Icon from '../components/ui/Icon.astro';
import Section from '../components/ui/Section.astro';
import { photoBySlug } from '../data/gallery.js';
import PageLayout from '../layouts/PageLayout.astro';
import { getNearbyPlaces } from '../lib/services/content.service.js';
import { withBase } from '../lib/utils/url.js';

const places = await getNearbyPlaces();

const tips = [
  {
    icon: 'sun',
    title: 'Clima',
    text: 'Ica tiene clima desértico: seco y soleado la mayor parte del año. En verano (de diciembre a marzo) los días son calurosos; protector solar, sombrero y agua son imprescindibles para las dunas.',
  },
  {
    icon: 'wine',
    title: 'Vendimia',
    text: 'En marzo, la ciudad celebra la Vendimia, la fiesta de la cosecha de la uva. Es una de las épocas más animadas del año y conviene consultar disponibilidad con tiempo.',
  },
  {
    icon: 'compass',
    title: 'Dunas al atardecer',
    text: 'Los paseos en arenero y el sandboarding en Huacachina se contratan con operadores locales. Las salidas de la tarde permiten ver la puesta de sol sobre el desierto.',
  },
  {
    icon: 'wave',
    title: 'Excursiones de un día',
    text: 'Paracas y las Islas Ballestas, al norte, y las Líneas de Nasca, al sur, se visitan en excursiones de un día y se vuelve a descansar a la casa.',
  },
];

const breadcrumbs = [
  { name: 'Inicio', href: '/' },
  { name: 'Experiencias', href: '/experiencia' },
];
---

<PageLayout
  title="Experiencias en Casa Leblanc y qué hacer en Ica"
  description="Escapadas familiares, momentos románticos y reuniones en una casa privada con piscina cerca de Huacachina. Además: dunas, bodegas, Paracas y Nasca desde Ica."
  heading="Experiencias en Casa Leblanc"
  eyebrow="Experiencias"
  intro="Una casa, infinitas experiencias: descanso en familia, noches en pareja, reuniones entre amigos y, a la salida, el oasis de Huacachina, las dunas y los viñedos de Ica."
  breadcrumbs={breadcrumbs}
  image={photoBySlug('piscina-zona-comedor-exterior-casa-leblanc')}
>
  <StayExperiencesSection index="01" tone="default" />

  <Section tone="sand" container="none" aria-labelledby="alojarse-title">
    <Container size="wide">
      <div class="stay">
        <Chapter
          index="02"
          eyebrow="Dónde alojarse en Ica"
          title="Una casa vacacional cerca de Huacachina"
          id="alojarse-title"
          titleWidth="16ch"
        />
        <div class="prose stay__prose">
          <p>
            Quien viaja a Ica suele buscar dos cosas: estar cerca del oasis de Huacachina y las
            dunas, y tener un lugar tranquilo donde descansar al volver. Una casa vacacional
            resuelve ambas: espacio propio, cocina para el grupo y la libertad de llegar y salir
            sin horarios de hotel.
          </p>
          <p>
            <a href={withBase('/casa')}>Casa Leblanc</a> se reserva completa, con piscina iluminada, jardín y
            terraza, y dormitorios con camas matrimoniales, camarotes y camas individuales. Es una
            opción pensada para familias y grupos que quieren conocer Ica a su ritmo.
          </p>
        </div>
      </div>
    </Container>
  </Section>

  <ExperienceSection
    places={places}
    index="03"
    title="Lugares para conocer en la región de Ica"
    description="Del oasis a la costa de Paracas: estos son los imprescindibles de la región, con distancias aproximadas desde el centro de la ciudad."
    actionHref="/ubicacion"
    actionLabel="Cómo llegar a Ica"
  />

  <Section tone="default" container="none" aria-labelledby="consejos-title">
    <Container size="wide">
      <Chapter
        index="04"
        eyebrow="Planifica tu viaje"
        title="Consejos para tu estadía en Ica"
        id="consejos-title"
        titleWidth="16ch"
      />

      <ul class="tips" role="list">
        {
          tips.map((tip) => (
            <li class="tip">
              <Icon name={tip.icon} size={22} class="tip__icon" />
              <h3 class="tip__title">{tip.title}</h3>
              <p class="tip__text">{tip.text}</p>
            </li>
          ))
        }
      </ul>
    </Container>
  </Section>
</PageLayout>

<style>
  .stay {
    display: grid;
    gap: var(--space-xl);
  }

  .stay__prose :global(p) {
    font-size: var(--text-lead);
    line-height: var(--leading-relaxed);
  }

  .tips {
    display: grid;
    gap: var(--space-2xl) var(--space-xl);
    margin-block-start: var(--space-3xl);
    padding: 0;
    list-style: none;
  }

  .tip {
    padding-block-start: var(--space-lg);
    border-block-start: 1px solid var(--color-border-strong);
  }

  .tip :global(.tip__icon) {
    color: var(--color-accent-strong);
  }

  .tip__title {
    margin-block-start: var(--space-md);
    font-size: var(--text-h3);
  }

  .tip__text {
    margin-block-start: var(--space-sm);
    font-size: var(--text-body-sm);
    line-height: var(--leading-relaxed);
    color: var(--color-text-muted);
  }

  @media (min-width: 48rem) {
    .tips {
      grid-template-columns: repeat(2, minmax(0, 1fr));
    }
  }

  @media (min-width: 64rem) {
    .stay {
      grid-template-columns: minmax(0, 5fr) minmax(0, 7fr);
      gap: clamp(3rem, 7vw, 7rem);
      align-items: start;
    }

    .tips {
      grid-template-columns: repeat(4, minmax(0, 1fr));
    }
  }
</style>
