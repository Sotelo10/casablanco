---
/**
 * CONTACTO — canales directos, formulario de consultas y ubicación.
 * Las consultas de fechas se derivan a /reservas.
 */
import ContactSection from '../components/sections/ContactSection.astro';
import LocationSection from '../components/sections/LocationSection.astro';
import Button from '../components/ui/Button.astro';
import Container from '../components/ui/Container.astro';
import Section from '../components/ui/Section.astro';
import { bookingHref } from '../config/navigation.js';
import PageLayout from '../layouts/PageLayout.astro';

const breadcrumbs = [
  { name: 'Inicio', href: '/' },
  { name: 'Contacto', href: '/contacto' },
];
---

<PageLayout
  title="Contacto · Casa Leblanc, Huacachina, Ica"
  description="Contacta con Casa Leblanc, casa vacacional cerca de Huacachina, Ica: WhatsApp Business, Instagram, Facebook y formulario de consultas."
  heading="Contacto"
  eyebrow="Casa Leblanc"
  intro="WhatsApp, redes sociales o el formulario: escríbenos por el canal que prefieras y te respondemos personalmente."
  breadcrumbs={breadcrumbs}
  showCta={false}
>
  <ContactSection index="01" tone="default" />

  <Section tone="sand" size="compact" container="none" aria-label="Reservas">
    <Container size="wide">
      <div class="booking-note">
        <p>¿Ya tienes fechas? Consulta la disponibilidad directamente.</p>
        <Button href={bookingHref} variant="primary" leadingIcon="calendar" icon="arrow-right">
          Ir a reservas
        </Button>
      </div>
    </Container>
  </Section>

  <LocationSection index="02" />
</PageLayout>

<style>
  .booking-note {
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    justify-content: space-between;
    gap: var(--space-md) var(--space-xl);
  }

  .booking-note p {
    font-family: var(--font-heading);
    font-size: var(--text-h3);
    line-height: 1.2;
  }
</style>
