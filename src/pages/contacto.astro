---
/**
 * RESERVA — solicitud de disponibilidad.
 */
import BookingForm from '../components/booking/BookingForm.astro';
import WhatsAppButton from '../components/booking/WhatsAppButton.astro';
import Card from '../components/ui/Card.astro';
import Chapter from '../components/ui/Chapter.astro';
import Container from '../components/ui/Container.astro';
import Icon from '../components/ui/Icon.astro';
import PlaceholderValue from '../components/ui/PlaceholderValue.astro';
import Section from '../components/ui/Section.astro';
import { formattedAddress, site } from '../config/site.js';
import PageLayout from '../layouts/PageLayout.astro';

const breadcrumbs = [
  { name: 'Inicio', href: '/' },
  { name: 'Reservar', href: '/contacto' },
];

const trust = [
  {
    icon: 'shield',
    title: 'Reserva directa',
    text: 'Escribes al propietario, sin intermediarios ni comisiones de plataforma.',
  },
  {
    icon: 'key',
    title: 'Una sola reserva a la vez',
    text: 'La casa se alquila completa: si está disponible, es para tu grupo.',
  },
  {
    icon: 'info',
    title: 'Sin compromiso',
    text: 'Consultar disponibilidad no reserva nada: primero te confirmamos condiciones.',
  },
];
---

<PageLayout
  title="Reservar estadía"
  description="Solicita la reserva de Casa Blanco en Ica: envía tus fechas y el número de huéspedes y te respondemos con disponibilidad, tarifa y condiciones."
  heading="Reserva tu estadía en Casa Blanco"
  eyebrow="Disponibilidad"
  intro="Escríbenos con tus fechas y el tamaño del grupo. Te respondemos con la disponibilidad, la tarifa y las condiciones de la estancia."
  breadcrumbs={breadcrumbs}
  showCta={false}
  showMobileBar={false}
>
  <Section tone="default" container="none" aria-labelledby="formulario-title">
    <Container size="wide">
      <div class="contact">
        <Card tone="surface" padding="lg" class="contact__form-card">
          <Chapter
            index="01"
            eyebrow="Formulario"
            title="Cuéntanos sobre tu viaje"
            id="formulario-title"
            titleWidth="18ch"
            class="contact__chapter"
          />
          <BookingForm />
        </Card>

        <aside class="contact__aside" aria-labelledby="contacto-directo">
          <Card tone="muted" padding="lg" class="contact__panel">
            <h2 id="contacto-directo" class="contact__title">Contacto directo</h2>

            <ul class="contact__list" role="list">
              <li class="contact__item">
                <span class="contact__icon"><Icon name="whatsapp" size={16} /></span>
                <div>
                  <p class="contact__label">WhatsApp</p>
                  <p class="contact__value">
                    <PlaceholderValue value={site.contact.phone} fallback="Número por confirmar" />
                  </p>
                </div>
              </li>
              <li class="contact__item">
                <span class="contact__icon"><Icon name="mail" size={16} /></span>
                <div>
                  <p class="contact__label">Correo</p>
                  <p class="contact__value">
                    {
                      site.contact.email ? (
                        <a href={`mailto:${site.contact.email}`}>{site.contact.email}</a>
                      ) : (
                        <PlaceholderValue value={null} fallback="Correo por confirmar" />
                      )
                    }
                  </p>
                </div>
              </li>
              <li class="contact__item">
                <span class="contact__icon"><Icon name="map-pin" size={16} /></span>
                <div>
                  <p class="contact__label">Ubicación</p>
                  <p class="contact__value">{formattedAddress()}</p>
                </div>
              </li>
              <li class="contact__item">
                <span class="contact__icon"><Icon name="clock" size={16} /></span>
                <div>
                  <p class="contact__label">Atención</p>
                  <p class="contact__value">{site.contact.hours}</p>
                </div>
              </li>
            </ul>

            <WhatsAppButton variant="outline" size="md" block class="contact__whatsapp" />
          </Card>

          <ul class="trust" role="list">
            {
              trust.map((item) => (
                <li class="trust__item">
                  <span class="trust__icon"><Icon name={item.icon} size={16} /></span>
                  <div>
                    <h3 class="trust__title">{item.title}</h3>
                    <p class="trust__text">{item.text}</p>
                  </div>
                </li>
              ))
            }
          </ul>
        </aside>
      </div>
    </Container>
  </Section>
</PageLayout>

<style>
  .contact {
    display: grid;
    gap: var(--space-xl);
  }

  .contact__chapter {
    margin-block-end: var(--space-xl);
  }

  .contact__title {
    font-family: var(--font-body);
    font-size: var(--text-2xs);
    font-weight: var(--weight-semibold);
    letter-spacing: var(--tracking-widest);
    text-transform: uppercase;
    color: var(--color-text-muted);
  }

  .contact__list {
    display: flex;
    flex-direction: column;
    gap: var(--space-lg);
    margin-block: var(--space-lg);
    list-style: none;
    padding: 0;
  }

  .contact__item {
    display: flex;
    align-items: flex-start;
    gap: var(--space-sm);
  }

  .contact__icon {
    display: grid;
    place-items: center;
    flex-shrink: 0;
    width: 2.25rem;
    height: 2.25rem;
    border-radius: var(--radius-pill);
    background-color: var(--color-surface);
    color: var(--color-primary);
  }

  .contact__label {
    font-size: var(--text-2xs);
    letter-spacing: var(--tracking-wide);
    text-transform: uppercase;
    color: var(--color-text-muted);
  }

  .contact__value {
    margin-block-start: 0.15rem;
    font-size: var(--text-body-sm);
  }

  .trust {
    display: grid;
    gap: var(--space-lg);
    margin-block-start: var(--space-xl);
    list-style: none;
    padding: 0;
  }

  .trust__item {
    display: flex;
    align-items: flex-start;
    gap: var(--space-sm);
  }

  .trust__icon {
    display: grid;
    place-items: center;
    flex-shrink: 0;
    width: 2rem;
    height: 2rem;
    border: 1px solid var(--color-border-strong);
    border-radius: var(--radius-pill);
    color: var(--color-primary);
  }

  .trust__title {
    font-family: var(--font-body);
    font-size: var(--text-body-sm);
    font-weight: var(--weight-semibold);
    letter-spacing: var(--tracking-normal);
  }

  .trust__text {
    margin-block-start: 0.15rem;
    font-size: var(--text-sm);
    line-height: var(--leading-relaxed);
    color: var(--color-text-muted);
  }

  @media (min-width: 64rem) {
    .contact {
      grid-template-columns: minmax(0, 1.5fr) minmax(0, 0.85fr);
      gap: var(--space-2xl);
      align-items: start;
    }

    .contact__aside {
      position: sticky;
      top: calc(var(--header-height) + var(--space-lg));
    }
  }
</style>
