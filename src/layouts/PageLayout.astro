---
/**
 * LAYOUT DE PÁGINAS INTERIORES
 * =============================================================================
 * Cabecera editorial: migas, antetítulo, H1 y entradilla sobre blanco cálido.
 * Si la página aporta una fotografía real (`image`), se compone a la derecha
 * del titular y actúa como imagen principal (LCP) de la página.
 */
import BookingCTA from '../components/booking/BookingCTA.astro';
import Breadcrumbs from '../components/navigation/Breadcrumbs.astro';
import Container from '../components/ui/Container.astro';
import PropertyImage from '../components/media/PropertyImage.astro';
import { responsiveSource } from '../lib/images.js';
import type { BreadcrumbEntry, JsonObject } from '../lib/seo/schema.js';
import type { GalleryImage, ReviewSummary } from '../types/content.js';
import BaseLayout from './BaseLayout.astro';

interface Props {
  title: string;
  description: string;
  /** Título visible (H1). Por defecto usa `title`. */
  heading?: string;
  eyebrow?: string;
  intro?: string;
  breadcrumbs?: BreadcrumbEntry[];
  schemas?: (JsonObject | null)[];
  reviewSummary?: ReviewSummary;
  noindex?: boolean;
  showCta?: boolean;
  showMobileBar?: boolean;
  /** Compatibilidad: la banda de cierre ya no dibuja curva. */
  ctaTopWave?: string;
  /** Fotografía real de cabecera (opcional). */
  image?: GalleryImage;
}

const {
  title,
  description,
  heading,
  eyebrow,
  intro,
  breadcrumbs = [],
  schemas = [],
  reviewSummary,
  noindex = false,
  showCta = true,
  showMobileBar = true,
  image,
} = Astro.props;

const headerImage = image ? responsiveSource(image) : null;
const imageSizes = '(min-width: 64rem) 40vw, 100vw';
---

<BaseLayout
  title={title}
  description={description}
  breadcrumbs={breadcrumbs}
  schemas={schemas}
  reviewSummary={reviewSummary}
  noindex={noindex}
  showMobileBar={showMobileBar}
  preloadImage={headerImage
    ? { href: headerImage.src, srcset: headerImage.srcset, sizes: imageSizes }
    : undefined}
>
  <header class:list={['page-header', image && 'page-header--media']}>
    <Container size="wide">
      {breadcrumbs.length > 1 && <Breadcrumbs items={breadcrumbs} class="page-header__crumbs" />}
      <div class="page-header__layout">
        <div class="page-header__body">
          {eyebrow && <span class="eyebrow page-header__eyebrow">{eyebrow}</span>}
          <h1 class="page-header__title">{heading ?? title}</h1>
          {intro && <p class="lead page-header__intro">{intro}</p>}
          <slot name="header-extra" />
        </div>
        {
          image && (
            <PropertyImage
              image={image}
              ratio="4 / 3"
              sizes={imageSizes}
              priority
              class="page-header__image"
            />
          )
        }
      </div>
    </Container>
  </header>

  <slot />

  {showCta && <BookingCTA />}
</BaseLayout>

<style>
  .page-header {
    padding-block: var(--space-xl) var(--section-space-sm);
    border-block-end: 1px solid var(--color-border);
    background-color: var(--color-background);
  }

  .page-header :global(.page-header__crumbs) {
    margin-block-end: var(--space-xl);
  }

  .page-header__layout {
    display: grid;
    gap: var(--space-2xl);
    align-items: end;
  }

  .page-header__body {
    display: flex;
    flex-direction: column;
    gap: var(--space-md);
  }

  .page-header__title {
    max-width: 16ch;
  }

  .page-header__intro {
    max-width: 52ch;
  }

  @media (min-width: 64rem) {
    .page-header {
      padding-block: var(--space-2xl) var(--section-space-sm);
    }

    .page-header__body {
      gap: var(--space-lg);
    }

    .page-header--media .page-header__layout {
      grid-template-columns: minmax(0, 7fr) minmax(0, 6fr);
      gap: clamp(3rem, 6vw, 6rem);
    }
  }
</style>
