---
/**
 * Marca tipográfica de Casa Blanco.
 *
 * Es intencionadamente tipográfica: el nombre en la serif editorial y la
 * localización en monoespaciada, como una firma de arquitectura. Cuando exista
 * un logotipo bastará con sustituir este componente.
 */
import { site } from '../../config/site.js';

interface Props {
  href?: string;
  tone?: 'default' | 'inverse';
  showLocation?: boolean;
  size?: 'sm' | 'md';
  class?: string;
}

const {
  href = '/',
  tone = 'default',
  showLocation = true,
  size = 'md',
  class: className,
  ...rest
} = Astro.props;
---

<a
  href={href}
  class:list={['brand', `brand--${size}`, tone === 'inverse' && 'brand--inverse', className]}
  aria-label={`${site.name} · Inicio`}
  {...rest}
>
  <span class="brand__name">{site.name}</span>
  {
    showLocation && (
      <span class="brand__location">
        {site.location.city} · {site.location.country}
      </span>
    )
  }
</a>

<style>
  .brand {
    display: inline-flex;
    flex-direction: column;
    gap: 0.25rem;
    padding-block: 0.35rem;
    text-decoration: none;
    line-height: 1;
  }

  .brand:hover {
    color: inherit;
  }

  .brand__name {
    font-family: var(--font-heading);
    font-weight: var(--weight-regular);
    letter-spacing: var(--tracking-tight);
    transition: color var(--duration-fast) var(--ease-out);
  }

  .brand--md .brand__name {
    font-size: 1.45rem;
  }

  .brand--sm .brand__name {
    font-size: 1.2rem;
  }

  .brand__location {
    font-family: var(--font-mono);
    font-size: var(--text-3xs);
    letter-spacing: var(--tracking-widest);
    text-transform: uppercase;
    color: var(--color-text-muted);
  }

  .brand--inverse .brand__location {
    color: var(--color-text-inverse-muted);
  }

  .brand:hover .brand__name {
    color: var(--color-primary);
  }

  .brand--inverse:hover .brand__name {
    color: var(--color-primary-light);
  }

  @media (min-width: 64rem) {
    .brand--md .brand__name {
      font-size: 1.7rem;
    }
  }
</style>
