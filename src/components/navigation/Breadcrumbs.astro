---
/**
 * Migas de pan. Se muestran sólo en páginas interiores, donde ayudan a
 * orientarse; el marcado BreadcrumbList lo emite el layout.
 */
import Icon from '../ui/Icon.astro';

export interface BreadcrumbItem {
  name: string;
  href: string;
}

interface Props {
  items: BreadcrumbItem[];
  tone?: 'default' | 'inverse';
  class?: string;
}

const { items, tone = 'default', class: className, ...rest } = Astro.props;
---

<nav
  class:list={['breadcrumbs', tone === 'inverse' && 'breadcrumbs--inverse', className]}
  aria-label="Ruta de navegación"
  {...rest}
>
  <ol class="breadcrumbs__list" role="list">
    {
      items.map((item, index) => {
        const isLast = index === items.length - 1;
        return (
          <li class="breadcrumbs__item">
            {isLast ? (
              <span aria-current="page">{item.name}</span>
            ) : (
              <>
                <a href={item.href}>{item.name}</a>
                <Icon name="chevron-right" size={13} class="breadcrumbs__sep" />
              </>
            )}
          </li>
        );
      })
    }
  </ol>
</nav>

<style>
  .breadcrumbs__list {
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    gap: var(--space-2xs);
    list-style: none;
    margin: 0;
    padding: 0;
    font-family: var(--font-mono);
    font-size: var(--text-2xs);
    letter-spacing: var(--tracking-wide);
    text-transform: uppercase;
    color: var(--color-text-muted);
  }

  .breadcrumbs__item {
    display: inline-flex;
    align-items: center;
    gap: var(--space-2xs);
  }

  .breadcrumbs__item a {
    display: inline-block;
    /* Área táctil cómoda sin engordar la línea visual. */
    padding-block: 0.8rem;
    text-decoration: none;
  }

  .breadcrumbs__item a:hover {
    text-decoration: underline;
  }

  .breadcrumbs__item [aria-current='page'] {
    display: inline-block;
    padding-block: 0.7rem;
    color: var(--color-text);
  }

  .breadcrumbs__sep {
    opacity: 0.5;
  }

  .breadcrumbs--inverse .breadcrumbs__list {
    color: var(--color-text-inverse-muted);
  }

  .breadcrumbs--inverse .breadcrumbs__item [aria-current='page'] {
    color: var(--color-text-inverse);
  }
</style>
