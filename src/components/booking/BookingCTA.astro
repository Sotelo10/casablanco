---
/**
 * BANDA DE CIERRE
 * =============================================================================
 * Último punto de conversión de cada página: fotografía real a sangre bajo un
 * velo azul profundo. Jerarquía explícita: una acción principal (reservar),
 * una alternativa directa (WhatsApp) y los datos de contacto reales.
 */
import { bookingHref, bookingLabel } from '../../config/navigation.js';
import { site } from '../../config/site.js';
import { photoBySlug } from '../../data/gallery.js';
import { responsiveSource } from '../../lib/images.js';
import Button from '../ui/Button.astro';
import Container from '../ui/Container.astro';
import Icon from '../ui/Icon.astro';
import WhatsAppButton from './WhatsAppButton.astro';

interface Props {
  eyebrow?: string;
  title?: string;
  description?: string;
  /** Compatibilidad con llamadas anteriores; ya no se dibuja la curva. */
  topWaveTone?: string;
}

const {
  eyebrow = 'Disponibilidad',
  title = 'Tu estadía en Ica empieza con un mensaje',
  description = 'Cuéntanos tus fechas y cuántas personas viajan. Te respondemos con la disponibilidad, la tarifa y las condiciones de la estadía.',
} = Astro.props;

const steps = [
  'Envías tus fechas y el tamaño del grupo.',
  'Te confirmamos disponibilidad, tarifa y condiciones.',
  'Coordinamos el ingreso y te enviamos la ubicación exacta.',
];

const backdrop = responsiveSource(photoBySlug('piscina-iluminada-casa-vacacional-ica'));
---

<section class="cta" aria-labelledby="cta-title">
  {
    backdrop && (
      <img
        class="cta__backdrop"
        src={backdrop.src}
        srcset={backdrop.srcset}
        sizes="100vw"
        width={backdrop.width}
        height={backdrop.height}
        alt=""
        loading="lazy"
        decoding="async"
      />
    )
  }

  <Container size="wide">
    <div class="cta__inner">
      <div class="cta__text">
        <span class="eyebrow cta__eyebrow">{eyebrow}</span>
        <h2 id="cta-title" class="cta__title">{title}</h2>
        <p class="cta__description">{description}</p>

        <ol class="cta__steps">
          {steps.map((step) => <li>{step}</li>)}
        </ol>
      </div>

      <div class="cta__panel">
        <p class="cta__panel-title">Reserva directa con el anfitrión</p>
        <p class="cta__panel-text">
          Sin intermediarios: escribes y te responde quien administra la casa.
        </p>

        <div class="cta__actions">
          <Button href={bookingHref} variant="light" size="lg" block leadingIcon="calendar">
            {bookingLabel}
          </Button>
          <WhatsAppButton variant="outline-light" size="lg" block />
        </div>

        <ul class="cta__contact" role="list">
          {
            site.contact.phone && (
              <li>
                <Icon name="phone" size={15} />
                <a href={`tel:${site.contact.phone.replace(/\s/g, '')}`}>{site.contact.phone}</a>
              </li>
            )
          }
          {
            site.contact.email && (
              <li>
                <Icon name="mail" size={15} />
                <a href={`mailto:${site.contact.email}`}>{site.contact.email}</a>
              </li>
            )
          }
          <li>
            <Icon name="map-pin" size={15} />
            <span>Huacachina · Ica, Perú</span>
          </li>
        </ul>
      </div>
    </div>
  </Container>
</section>

<style>
  .cta {
    position: relative;
    padding-block: var(--section-space);
    overflow: hidden;
    color: var(--color-text-inverse);
    background-color: var(--color-surface-deep);
    isolation: isolate;
  }

  .cta__backdrop {
    position: absolute;
    inset: 0;
    z-index: -2;
    width: 100%;
    height: 100%;
    object-fit: cover;
    object-position: 50% 70%;
  }

  .cta::before {
    content: '';
    position: absolute;
    inset: 0;
    z-index: -1;
    background: linear-gradient(
      100deg,
      rgb(var(--veil-rgb) / 95%) 0%,
      rgb(var(--veil-rgb) / 78%) 50%,
      rgb(var(--veil-rgb) / 50%) 100%
    );
  }

  .cta__inner {
    display: grid;
    gap: var(--space-3xl);
    align-items: center;
  }

  .cta__eyebrow {
    color: var(--color-accent-light);
  }

  .cta__title {
    margin-block-start: var(--space-md);
    max-width: 15ch;
    font-size: var(--text-h2);
  }

  .cta__description {
    margin-block-start: var(--space-lg);
    max-width: 46ch;
    line-height: var(--leading-relaxed);
    color: var(--color-text-inverse-muted);
  }

  .cta__steps {
    display: grid;
    gap: var(--space-sm);
    margin-block-start: var(--space-xl);
    padding: 0;
    list-style: none;
    counter-reset: step;
  }

  .cta__steps li {
    display: flex;
    align-items: baseline;
    gap: var(--space-md);
    font-size: var(--text-body-sm);
    color: rgb(var(--white-rgb) / 88%);
    counter-increment: step;
  }

  .cta__steps li::before {
    content: counter(step, decimal-leading-zero);
    font-family: var(--font-heading);
    font-size: 1.25rem;
    font-style: italic;
    color: var(--color-accent-light);
  }

  .cta__panel {
    padding: clamp(1.5rem, 1rem + 2vw, 2.5rem);
    border: 1px solid var(--color-border-inverse);
    background-color: rgb(var(--veil-rgb) / 55%);
  }

  @supports (backdrop-filter: blur(1px)) {
    .cta__panel {
      backdrop-filter: blur(12px);
    }
  }

  .cta__panel-title {
    font-family: var(--font-heading);
    font-size: 1.75rem;
    font-weight: var(--weight-heading);
    line-height: 1.2;
  }

  .cta__panel-text {
    margin-block-start: var(--space-xs);
    font-size: var(--text-body-sm);
    color: var(--color-text-inverse-muted);
  }

  .cta__actions {
    display: grid;
    gap: var(--space-sm);
    margin-block-start: var(--space-xl);
  }

  .cta__contact {
    display: grid;
    gap: var(--space-xs);
    margin-block-start: var(--space-xl);
    padding: var(--space-lg) 0 0;
    border-block-start: 1px solid var(--color-border-inverse);
    list-style: none;
    font-size: var(--text-sm);
    color: var(--color-text-inverse-muted);
  }

  .cta__contact li {
    display: flex;
    align-items: center;
    gap: var(--space-xs);
  }

  .cta__contact a {
    color: var(--color-text-inverse);
    text-decoration: none;
    font-variant-numeric: tabular-nums;
  }

  .cta__contact a:hover {
    color: var(--color-accent-light);
  }

  @media (min-width: 64rem) {
    .cta__inner {
      grid-template-columns: minmax(0, 7fr) minmax(0, 5fr);
      gap: clamp(3rem, 8vw, 8rem);
    }
  }
</style>
