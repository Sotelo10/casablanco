---
/**
 * MAPA DE UBICACIÓN
 * =============================================================================
 * Se incrusta con la Google Maps Embed API sólo si hay clave pública
 * (`PUBLIC_GOOGLE_MAPS_API_KEY`) y coordenadas o dirección en la configuración.
 * La clave nunca se escribe en el código: se lee de las variables de entorno.
 *
 * Mientras no haya dirección exacta, se muestra una fotografía real de la casa
 * con la ZONA publicada (Huacachina · Ica) y un enlace a esa zona en Google
 * Maps, rotulado como aproximado. Nunca se señala un punto inventado.
 */
import { formattedCity, site } from '../../config/site.js';
import { photoBySlug } from '../../data/gallery.js';
import { responsiveSource } from '../../lib/images.js';
import { googleMapsEmbedUrl, googleMapsLink, googleMapsZoneLink } from '../../lib/utils/maps.js';
import Icon from '../ui/Icon.astro';

interface Props {
  class?: string;
  /**
   * Proporción fija. Si se omite, usa 4:3 en móvil y 16:9 desde tablet, que es
   * lo que mejor encaja en las secciones de ancho completo.
   */
  ratio?: string;
}

const { class: className, ratio, ...rest } = Astro.props;
const embedUrl = googleMapsEmbedUrl();
const mapsUrl = googleMapsLink();
const zoneUrl = googleMapsZoneLink();
const zone = [site.location.area, formattedCity()].filter(Boolean).join(' · ');
const photo = responsiveSource(photoBySlug('casa-leblanc-ica-fachada-piscina-noche'));
---

<div
  class:list={['map', className]}
  style={ratio ? `--map-ratio:${ratio}` : undefined}
  {...rest}
>
  {
    embedUrl ? (
      <iframe
        class="map__frame"
        src={embedUrl}
        title={`Mapa de la ubicación de ${site.name} en ${site.location.city}`}
        loading="lazy"
        referrerpolicy="no-referrer-when-downgrade"
        allowfullscreen
      />
    ) : (
      <div class="map__fallback">
        {photo && (
          <img
            class="map__photo"
            src={photo.src}
            srcset={photo.srcset}
            sizes="(min-width: 64rem) 50vw, 100vw"
            width={photo.width}
            height={photo.height}
            alt=""
            loading="lazy"
            decoding="async"
          />
        )}
        <span class="map__pin">
          <Icon name="map-pin" size={22} />
        </span>
        <p class="map__title">{zone}</p>
        <p class="map__hint">Ubicación exacta al confirmar la reserva.</p>
        {(mapsUrl ?? zoneUrl) && (
          <a
            class="map__link"
            href={mapsUrl ?? zoneUrl}
            target="_blank"
            rel="noopener noreferrer"
          >
            {mapsUrl ? 'Abrir en Google Maps' : 'Ver la zona en Google Maps'}
            <Icon name="arrow-up-right" size={15} />
          </a>
        )}
      </div>
    )
  }
</div>

<style>
  .map {
    position: relative;
    aspect-ratio: var(--map-ratio, 4 / 3);
    overflow: hidden;
    border-radius: var(--radius-sm);
    background-color: var(--color-surface-soft);
  }

  .map__frame {
    width: 100%;
    height: 100%;
    border: 0;
  }

  .map__fallback {
    position: relative;
    display: flex;
    flex-direction: column;
    align-items: center;
    justify-content: center;
    gap: var(--space-xs);
    height: 100%;
    padding: var(--space-xl);
    text-align: center;
    color: var(--color-text-inverse);
    background-color: var(--color-surface-deep);
    isolation: isolate;
  }

  .map__fallback::before {
    content: '';
    position: absolute;
    inset: 0;
    z-index: -1;
    background-color: rgb(var(--veil-rgb) / 72%);
  }

  .map__photo {
    position: absolute;
    inset: 0;
    z-index: -2;
    width: 100%;
    height: 100%;
    object-fit: cover;
    object-position: 50% 45%;
  }

  .map__pin {
    display: grid;
    place-items: center;
    width: 3rem;
    height: 3rem;
    border: 1px solid var(--color-border-inverse-strong);
    border-radius: var(--radius-pill);
    color: var(--color-text-inverse);
  }

  .map__title {
    margin-block-start: var(--space-xs);
    font-family: var(--font-heading);
    font-size: var(--text-h3);
    font-weight: var(--weight-heading);
  }

  .map__hint {
    max-width: 40ch;
    font-size: var(--text-sm);
    color: var(--color-text-inverse-muted);
  }

  .map__link {
    display: inline-flex;
    align-items: center;
    gap: 0.35rem;
    min-height: 2.75rem;
    margin-block-start: var(--space-sm);
    font-size: var(--text-2xs);
    font-weight: var(--weight-semibold);
    letter-spacing: var(--tracking-wider);
    text-transform: uppercase;
    color: var(--color-text-inverse);
  }

  .map__link:hover {
    color: var(--color-accent-light);
  }

  @media (min-width: 48rem) {
    .map {
      --map-ratio: 16 / 9;
    }
  }
</style>
