---
/**
 * MAPA DE UBICACIÓN
 * =============================================================================
 * Se incrusta con la Google Maps Embed API sólo si hay clave pública
 * (`PUBLIC_GOOGLE_MAPS_API_KEY`) y coordenadas o dirección en la configuración.
 * La clave nunca se escribe en el código: se lee de las variables de entorno.
 *
 * Sin configuración se muestra una placa con el mismo lenguaje visual que las
 * fotografías pendientes, de modo que la página nunca enseña un hueco roto.
 */
import { formattedCity, site } from '../../config/site.js';
import { googleMapsEmbedUrl, googleMapsLink } from '../../lib/utils/maps.js';
import Icon from '../ui/Icon.astro';

interface Props {
  class?: string;
  /**
   * Proporción fija. Si se omite, usa 4:3 en móvil y 16:9 desde tablet, que es
   * lo que mejor encaja en las secciones de ancho completo.
   */
  ratio?: string;
}

const { class: className, ratio, ...rest } = Astro.props;
const embedUrl = googleMapsEmbedUrl();
const mapsUrl = googleMapsLink();
---

<div
  class:list={['map', className]}
  style={ratio ? `--map-ratio:${ratio}` : undefined}
  {...rest}
>
  {
    embedUrl ? (
      <iframe
        class="map__frame"
        src={embedUrl}
        title={`Mapa de la ubicación de ${site.name} en ${site.location.city}`}
        loading="lazy"
        referrerpolicy="no-referrer-when-downgrade"
        allowfullscreen
      />
    ) : (
      <div class="map__fallback">
        <svg class="map__motif" viewBox="0 0 200 160" aria-hidden="true" focusable="false">
          <path
            d="M55 160V78a45 45 0 0 1 90 0v82"
            fill="none"
            stroke="currentColor"
            stroke-width="1.25"
          />
        </svg>

        <span class="map__pin">
          <Icon name="map-pin" size={22} />
        </span>
        <p class="map__title">{formattedCity(' · ')}</p>
        <p class="map__hint">
          El mapa se activa al configurar <code>PUBLIC_GOOGLE_MAPS_API_KEY</code> y las coordenadas
          de la propiedad.
        </p>
        {
          mapsUrl && (
            <a class="map__link" href={mapsUrl} target="_blank" rel="noopener noreferrer">
              Abrir en Google Maps
              <Icon name="arrow-up-right" size={15} />
            </a>
          )
        }
      </div>
    )
  }
</div>

<style>
  .map {
    position: relative;
    aspect-ratio: var(--map-ratio, 4 / 3);
    overflow: hidden;
    border: 1px solid var(--color-border);
    border-radius: var(--radius-lg);
    background-color: var(--color-surface-soft);
  }

  .map__frame {
    width: 100%;
    height: 100%;
    border: 0;
  }

  .map__fallback {
    position: relative;
    display: flex;
    flex-direction: column;
    align-items: center;
    justify-content: center;
    gap: var(--space-xs);
    height: 100%;
    padding: var(--space-xl);
    text-align: center;
    background-image: radial-gradient(
        110% 80% at 50% 0%,
        rgb(var(--white-rgb) / 65%) 0%,
        transparent 55%
      ),
      linear-gradient(165deg, var(--color-surface-soft) 0%, var(--sky-200) 100%);
    isolation: isolate;
  }

  .map__fallback::before {
    content: '';
    position: absolute;
    inset: 0;
    background-image: repeating-linear-gradient(
      -45deg,
      rgb(var(--deep-rgb) / 3.5%) 0 1px,
      transparent 1px 14px
    );
  }

  .map__motif {
    position: absolute;
    inset-block-end: 0;
    inset-inline: 0;
    z-index: -1;
    width: min(50%, 18rem);
    height: auto;
    margin-inline: auto;
    color: rgb(var(--deep-rgb) / 10%);
  }

  .map__pin {
    display: grid;
    place-items: center;
    width: 3rem;
    height: 3rem;
    border-radius: var(--radius-pill);
    background-color: var(--color-surface);
    color: var(--color-primary);
    box-shadow: var(--shadow-sm);
  }

  .map__title {
    margin-block-start: var(--space-xs);
    font-family: var(--font-heading);
    font-size: var(--text-h3);
  }

  .map__hint {
    max-width: 40ch;
    font-size: var(--text-sm);
    color: var(--color-text-muted);
  }

  .map__hint code {
    padding: 0.1em 0.4em;
    border-radius: var(--radius-xs);
    background-color: var(--color-surface);
    font-size: 0.9em;
  }

  .map__link {
    display: inline-flex;
    align-items: center;
    gap: 0.35rem;
    margin-block-start: var(--space-sm);
    padding-block: 0.5rem;
    font-size: var(--text-body-sm);
    font-weight: var(--weight-medium);
  }

  @media (min-width: 48rem) {
    .map {
      --map-ratio: 16 / 9;
    }
  }
</style>
