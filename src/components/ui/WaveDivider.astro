---
/**
 * TRANSICIÓN CURVA
 * =============================================================================
 * Corte ondulado entre bloques: es la firma de composición del sitio y lo que
 * convierte el paso del hero al contenido en algo continuo en lugar de un corte
 * recto. Se dibuja con SVG (escala sin pixelarse y pesa unos bytes).
 */
interface Props {
  /** Color del bloque hacia el que se abre la curva. */
  tone?: 'background' | 'surface' | 'soft' | 'deep' | 'sand';
  /** `bottom` cierra el bloque actual; `top` abre el siguiente. */
  position?: 'bottom' | 'top';
  class?: string;
}

const { tone = 'background', position = 'bottom', class: className, ...rest } = Astro.props;
---

<div
  class:list={['wave', `wave--${tone}`, `wave--${position}`, className]}
  aria-hidden="true"
  {...rest}
>
  <svg viewBox="0 0 1440 120" preserveAspectRatio="none" focusable="false">
    <path
      d="M0 120V78C168 26 396 2 690 24c214 16 372 58 528 62 88 2 164-8 222-28v62z"
      fill="currentColor"
    />
  </svg>
</div>

<style>
  .wave {
    position: absolute;
    inset-inline: 0;
    z-index: var(--z-base);
    width: 100%;
    height: clamp(2.5rem, 5.5vw, 6.5rem);
    line-height: 0;
    pointer-events: none;
  }

  .wave svg {
    width: 100%;
    height: 100%;
    display: block;
  }

  .wave--bottom {
    inset-block-end: -1px;
  }

  .wave--top {
    inset-block-start: -1px;
    transform: scaleY(-1);
  }

  .wave--background {
    color: var(--color-background);
  }

  .wave--surface {
    color: var(--color-surface);
  }

  .wave--soft {
    color: var(--color-surface-soft);
  }

  .wave--sand {
    color: var(--color-surface-sand);
  }

  .wave--deep {
    color: var(--color-surface-deep);
  }
</style>
