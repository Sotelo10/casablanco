---
/**
 * Botón / enlace de acción.
 *
 * Renderiza `<a>` cuando recibe `href` y `<button>` en caso contrario, para no
 * romper la semántica ni la navegación por teclado. Todas las variantes salen
 * de los tokens: no hay colores, radios ni sombras propias.
 *
 * Admite un icono de apertura (`leadingIcon`, p. ej. un calendario) y otro de
 * cierre (`icon`, normalmente la flecha que se desplaza al pasar el cursor).
 */
import Icon from './Icon.astro';
import { withBase } from '../../lib/utils/url.js';

interface Props {
  href?: string;
  type?: 'button' | 'submit' | 'reset';
  /**
   * `primary` azul profundo · `accent` oro · `light` blanco sobre fotografía ·
   * `glass` cristal sobre fotografía · `outline` sobre fondo claro ·
   * `outline-light` sobre fondo profundo · `ghost` y `link` sin caja.
   */
  variant?: 'primary' | 'accent' | 'light' | 'glass' | 'outline' | 'outline-light' | 'ghost' | 'link';
  size?: 'sm' | 'md' | 'lg';
  block?: boolean;
  /** Icono de cierre (derecha). */
  icon?: string;
  iconPosition?: 'start' | 'end';
  /** Icono de apertura (izquierda), destacado en las variantes sobre foto. */
  leadingIcon?: string;
  external?: boolean;
  disabled?: boolean;
  class?: string;
  id?: string;
  'aria-label'?: string;
}

const {
  href,
  type = 'button',
  variant = 'primary',
  size = 'md',
  block = false,
  icon,
  iconPosition = 'end',
  leadingIcon,
  external = false,
  disabled = false,
  class: className,
  ...rest
} = Astro.props;

const Tag = href ? 'a' : 'button';
const resolvedHref = href ? withBase(href) : undefined;
const externalAttrs = external ? { target: '_blank', rel: 'noopener noreferrer' } : {};
const iconSize = size === 'lg' ? 18 : size === 'sm' ? 15 : 16;
---

<Tag
  class:list={['btn', `btn--${variant}`, `btn--${size}`, block && 'btn--block', className]}
  href={resolvedHref}
  type={href ? undefined : type}
  aria-disabled={disabled ? 'true' : undefined}
  disabled={!href && disabled ? true : undefined}
  {...externalAttrs}
  {...rest}
>
  {leadingIcon && <span class="btn__lead"><Icon name={leadingIcon} size={iconSize} /></span>}
  {icon && iconPosition === 'start' && !leadingIcon && (
    <Icon name={icon} size={iconSize} class="btn__icon btn__icon--start" />
  )}
  <span class="btn__label"><slot /></span>
  {icon && iconPosition === 'end' && <Icon name={icon} size={iconSize} class="btn__icon btn__icon--end" />}
</Tag>

<style>
  .btn {
    position: relative;
    display: inline-flex;
    align-items: center;
    justify-content: center;
    gap: 0.65em;
    border: 1px solid transparent;
    border-radius: var(--radius-button);
    font-family: var(--font-body);
    font-weight: var(--weight-semibold);
    letter-spacing: 0.12em;
    text-transform: uppercase;
    line-height: 1.2;
    text-align: center;
    text-decoration: none;
    white-space: nowrap;
    cursor: pointer;
    transition: background-color var(--transition-fast), color var(--transition-fast),
      border-color var(--transition-fast), box-shadow var(--transition-base),
      transform var(--transition-emphasis);
  }

  .btn:hover {
    color: inherit;
  }

  .btn:active {
    transform: translateY(1px);
  }

  .btn[aria-disabled='true'],
  .btn:disabled {
    opacity: 0.5;
    cursor: not-allowed;
    pointer-events: none;
  }

  /* Tamaños: siempre por encima del área táctil recomendada. */
  .btn--sm {
    min-height: 2.75rem;
    padding: 0.55rem 1.2rem;
    font-size: var(--text-2xs);
  }

  .btn--md {
    min-height: 3rem;
    padding: 0.75rem 1.7rem;
    font-size: var(--text-xs);
  }

  .btn--lg {
    min-height: 3.5rem;
    padding: 0.9rem 2.1rem;
    font-size: var(--text-xs);
  }

  .btn--lg .btn__lead {
    margin-inline-start: -0.35rem;
  }

  .btn--block {
    display: flex;
    width: 100%;
  }

  .btn__lead {
    display: grid;
    place-items: center;
    flex-shrink: 0;
  }

  .btn--primary {
    background-color: var(--color-primary);
    color: var(--color-primary-contrast);
  }

  .btn--primary:hover {
    background-color: var(--color-primary-hover);
    color: var(--color-primary-contrast);
  }

  .btn--accent {
    background-color: var(--color-primary);
    color: var(--color-primary-contrast);
  }

  .btn--accent:hover {
    background-color: var(--color-primary-hover);
    color: var(--color-primary-contrast);
  }

  /* Acción principal sobre fotografía: blanco pleno, la de mayor contraste. */
  .btn--light {
    background-color: var(--color-surface);
    color: var(--color-text);
  }

  .btn--light:hover {
    background-color: var(--color-surface);
    color: var(--color-primary-dark);
  }

  .btn--light .btn__lead {
    color: var(--color-primary);
  }

  /* Acción secundaria sobre fotografía: cristal con borde fino. */
  .btn--glass {
    border-color: var(--glass-border);
    background-color: rgb(var(--white-rgb) / 14%);
    color: var(--color-text-inverse);
  }

  @supports (backdrop-filter: blur(1px)) {
    .btn--glass {
      backdrop-filter: blur(10px) saturate(130%);
    }
  }

  .btn--glass:hover {
    background-color: rgb(var(--white-rgb) / 24%);
    border-color: var(--color-border-inverse-strong);
    color: var(--color-text-inverse);
  }



  .btn--outline {
    border-color: var(--color-border-strong);
    color: var(--color-text);
    background-color: var(--color-surface);
  }

  .btn--outline:hover {
    border-color: var(--color-primary);
    color: var(--color-primary-dark);
  }

  .btn--outline-light {
    border-color: var(--color-border-inverse);
    color: var(--color-text-inverse);
    background-color: rgb(var(--white-rgb) / 8%);
  }

  .btn--outline-light:hover {
    background-color: rgb(var(--white-rgb) / 16%);
    border-color: var(--color-border-inverse-strong);
    color: var(--color-text-inverse);
  }

  .btn--ghost {
    color: var(--color-text);
    padding-inline: 0.5rem;
  }

  .btn--ghost:hover {
    color: var(--color-primary);
  }

  /* Enlace de acción con filete animado: navegación secundaria. */
  .btn--link {
    min-height: 2rem;
    padding: 0.45rem 0;
    border-radius: 0;
    color: var(--color-text);
    font-size: var(--text-2xs);
  }

  .btn--link .btn__label {
    position: relative;
    padding-block-end: 0.25rem;
  }

  .btn--link .btn__label::after {
    content: '';
    position: absolute;
    inset-inline: 0;
    inset-block-end: 0;
    height: 1px;
    background-color: currentColor;
    transform-origin: right;
    transition: transform var(--transition-emphasis);
  }

  .btn--link:hover {
    color: var(--color-primary);
  }

  @media (prefers-reduced-motion: no-preference) {
    .btn--link .btn__label::after {
      transform: scaleX(1);
    }

    .btn--link:hover .btn__label::after {
      transform-origin: left;
      animation: link-underline var(--duration) var(--ease-emphasis);
    }

    @keyframes link-underline {
      0% {
        transform: scaleX(1);
        transform-origin: right;
      }

      49% {
        transform: scaleX(0);
        transform-origin: right;
      }

      50% {
        transform: scaleX(0);
        transform-origin: left;
      }

      100% {
        transform: scaleX(1);
        transform-origin: left;
      }
    }

    .btn__icon {
      transition: transform var(--transition-emphasis);
    }

    .btn:hover .btn__icon--end {
      transform: translateX(3px);
    }

    .btn:hover .btn__icon--start {
      transform: translateX(-2px);
    }
  }
</style>
