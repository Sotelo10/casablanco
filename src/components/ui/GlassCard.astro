---
/**
 * TARJETA DE CRISTAL
 * =============================================================================
 * Pieza flotante sobre fotografía: fondo semitransparente, desenfoque leve,
 * borde fino y sombra suave. El desenfoque es discreto a propósito — lo justo
 * para separar el texto de la imagen sin convertirlo en un efecto.
 *
 * Si el navegador no soporta `backdrop-filter`, el fondo sube de opacidad para
 * mantener la legibilidad.
 */
export interface Props {
  as?: 'div' | 'aside' | 'figure' | 'article';
  /**
   * `light` (por defecto) cristal claro con texto oscuro, para zonas luminosas
   * de la fotografía. `dark` cristal oscuro con texto claro.
   */
  tone?: 'light' | 'dark';
  class?: string;
}

const { as: Tag = 'div', tone = 'light', class: className, ...rest } = Astro.props;
---

<Tag class:list={['glass', `glass--${tone}`, className]} {...rest}>
  <slot />
</Tag>

<style>
  .glass {
    position: relative;
    padding: var(--space-lg);
    border: 1px solid var(--glass-border);
    border-radius: var(--radius-lg);
    box-shadow: var(--shadow-glass);
    overflow: hidden;
  }

  .glass--light {
    background-color: rgb(var(--white-rgb) / 90%);
    color: var(--color-text);
  }

  .glass--dark {
    background-color: rgb(var(--deep-rgb) / 58%);
    color: var(--color-text-inverse);
  }

  @supports (backdrop-filter: blur(1px)) {
    .glass--light {
      background-color: rgb(var(--white-rgb) / 74%);
      backdrop-filter: blur(var(--glass-blur)) saturate(140%);
    }

    .glass--dark {
      background-color: rgb(var(--deep-rgb) / 42%);
      backdrop-filter: blur(var(--glass-blur)) saturate(130%);
    }
  }

  /* Reflejo superior: el detalle que hace que se lea como cristal y no como
     una caja translúcida. */
  .glass::before {
    content: '';
    position: absolute;
    inset-block-start: 0;
    inset-inline: 10%;
    height: 1px;
    background: linear-gradient(
      to right,
      transparent,
      rgb(var(--white-rgb) / 55%),
      transparent
    );
  }
</style>
