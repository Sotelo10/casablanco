---
/**
 * Icono SVG en línea. Sin dependencias: los trazos viven en `icons.ts`.
 * Es decorativo por defecto (`aria-hidden`); pasa `label` para exponerlo.
 */
import { filledIcons, getIcon } from './icons.js';

interface Props {
  name: string;
  size?: number | string;
  /** Texto accesible. Si se omite, el icono se oculta a lectores de pantalla. */
  label?: string;
  class?: string;
  strokeWidth?: number;
}

const { name, size = 24, label, class: className, strokeWidth = 1.4, ...rest } = Astro.props;
const isFilled = filledIcons.has(name);
---

<svg
  class:list={['icon', className]}
  width={size}
  height={size}
  viewBox="0 0 24 24"
  fill={isFilled ? 'currentColor' : 'none'}
  stroke={isFilled ? 'none' : 'currentColor'}
  stroke-width={strokeWidth}
  stroke-linecap="round"
  stroke-linejoin="round"
  role={label ? 'img' : undefined}
  aria-label={label}
  aria-hidden={label ? undefined : 'true'}
  focusable="false"
  {...rest}
  set:html={getIcon(name)}
/>

<style>
  .icon {
    flex-shrink: 0;
  }
</style>
