---
/**
 * Tarjeta de reseña.
 * Las reseñas de demostración se marcan de forma explícita: nunca se presentan
 * opiniones ficticias como si fueran reales.
 */
import { formatDate, reviewSourceLabel } from '../../lib/utils/format.js';
import type { Review } from '../../types/content.js';
import Card from '../ui/Card.astro';
import StarRating from './StarRating.astro';

interface Props {
  review: Review;
  /** `feature` para la reseña destacada, con tipografía mayor. */
  variant?: 'default' | 'feature';
  class?: string;
}

const { review, variant = 'default', class: className, ...rest } = Astro.props;
---

<Card
  as="article"
  tone={variant === 'feature' ? 'muted' : 'surface'}
  padding="lg"
  class:list={['review', `review--${variant}`, className]}
  {...rest}
>
  <StarRating value={review.rating} size={15} label={`${review.rating} de 5 estrellas`} />

  <blockquote class="review__quote">
    <p>{review.comment}</p>
  </blockquote>

  <footer class="review__footer">
    <p class="review__author">
      <span class="review__name">{review.guestName}</span>
      {review.location && <span class="review__location">{review.location}</span>}
    </p>
    <p class="review__meta">
      <span>{reviewSourceLabel(review.source)}</span>
      <span aria-hidden="true">·</span>
      <span>{formatDate(review.publishedAt)}</span>
      {review.isDemo && <span class="review__demo">Ejemplo</span>}
    </p>
  </footer>
</Card>

<style>
  .review {
    gap: var(--space-md);
    height: 100%;
  }

  .review__quote p {
    font-family: var(--font-heading);
    font-size: 1.3rem;
    line-height: var(--leading-snug);
    color: var(--color-text);
    text-wrap: pretty;
  }

  .review--feature .review__quote p {
    font-size: clamp(1.5rem, 1.2rem + 1.3vw, 2.15rem);
  }

  .review__quote p::before {
    content: '“';
    margin-inline-end: 0.05em;
    color: var(--color-primary);
  }

  .review__quote p::after {
    content: '”';
    color: var(--color-primary);
  }

  .review__footer {
    display: flex;
    flex-wrap: wrap;
    align-items: baseline;
    justify-content: space-between;
    gap: var(--space-xs) var(--space-md);
    margin-block-start: auto;
    padding-block-start: var(--space-md);
    border-block-start: 1px solid var(--color-border);
  }

  .review--feature .review__footer {
    border-block-start-color: var(--color-border-strong);
  }

  .review__author {
    display: flex;
    flex-wrap: wrap;
    align-items: baseline;
    gap: 0.5rem;
  }

  .review__name {
    font-size: var(--text-body-sm);
    font-weight: var(--weight-semibold);
  }

  .review__location,
  .review__meta {
    font-size: var(--text-sm);
    color: var(--color-text-muted);
  }

  .review__meta {
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    gap: 0.4rem;
  }

  .review__demo {
    padding: 0.3em 0.65em;
    border: 1px dashed var(--color-border-strong);
    border-radius: var(--radius-pill);
    font-family: var(--font-mono);
    font-size: var(--text-3xs);
    letter-spacing: var(--tracking-wide);
    text-transform: uppercase;
  }
</style>
