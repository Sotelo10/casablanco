---
/**
 * CAPÍTULO DE PREGUNTAS FRECUENTES
 * =============================================================================
 * Resuelve las dudas que frenan una reserva justo antes del CTA final. Se
 * reutiliza en la portada (resumen) y en /faq (listado completo).
 */
import type { FaqItem } from '../../types/content.js';
import Button from '../ui/Button.astro';
import Chapter from '../ui/Chapter.astro';
import Container from '../ui/Container.astro';
import Icon from '../ui/Icon.astro';
import Section from '../ui/Section.astro';

interface Props {
  faqs: FaqItem[];
  index?: string;
  title?: string;
  description?: string;
  actionHref?: string;
  actionLabel?: string;
  tone?: 'default' | 'surface' | 'muted';
  /** Muestra el aviso de respuesta pendiente bajo cada respuesta provisional. */
  showPending?: boolean;
}

const {
  faqs,
  index = '07',
  title = 'Antes de reservar',
  description = 'Las dudas más habituales de quienes escriben por primera vez.',
  actionHref,
  actionLabel,
  tone = 'surface',
  showPending = false,
} = Astro.props;
---

<Section tone={tone} container="none" aria-labelledby="faq-title">
  <Container size="default">
    <Chapter
      index={index}
      eyebrow="Preguntas frecuentes"
      title={title}
      description={description}
      id="faq-title"
      actionHref={actionHref}
      actionLabel={actionLabel}
      titleWidth="14ch"
    />

    <ul class="faqs" role="list">
      {
        faqs.map((faq) => (
          <li>
            <details class="faq" name="faq-home">
              <summary class="faq__question">
                <span>{faq.question}</span>
                <span class="faq__marker" aria-hidden="true">
                  <Icon name="chevron-down" size={16} />
                </span>
              </summary>
              <div class="faq__answer">
                <p>{faq.answer}</p>
                {showPending && faq.isPlaceholder && (
                  <p class="faq__pending">Respuesta pendiente de confirmar con el dato definitivo.</p>
                )}
              </div>
            </details>
          </li>
        ))
      }
    </ul>

    {
      actionHref && actionLabel && (
        <div class="faqs__action">
          <Button href={actionHref} variant="outline" icon="arrow-right">
            {actionLabel}
          </Button>
        </div>
      )
    }
  </Container>
</Section>

<style>
  .faqs {
    list-style: none;
    margin: 0;
    padding: 0;
    border-block-start: 1px solid var(--color-border);
  }

  .faq {
    border-block-end: 1px solid var(--color-border);
  }

  .faq__question {
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: var(--space-md);
    padding-block: var(--space-lg);
    font-family: var(--font-heading);
    font-size: var(--text-h3);
    line-height: var(--leading-snug);
    cursor: pointer;
    list-style: none;
    transition: color var(--duration-fast) var(--ease-out);
  }

  .faq__question::-webkit-details-marker {
    display: none;
  }

  .faq__question:hover {
    color: var(--color-primary);
  }

  .faq__marker {
    display: grid;
    place-items: center;
    flex-shrink: 0;
    width: 2.25rem;
    height: 2.25rem;
    border: 1px solid var(--color-border-strong);
    border-radius: var(--radius-pill);
    color: var(--color-text-muted);
    transition: transform var(--duration) var(--ease-emphasis),
      background-color var(--duration-fast) var(--ease-out),
      color var(--duration-fast) var(--ease-out);
  }

  .faq[open] .faq__marker {
    transform: rotate(180deg);
    background-color: var(--color-primary-soft);
    border-color: transparent;
    color: var(--color-primary);
  }

  .faq__answer {
    padding-block-end: var(--space-lg);
    max-width: 62ch;
    color: var(--color-text-muted);
    line-height: var(--leading-relaxed);
  }

  .faq__pending {
    margin-block-start: var(--space-sm);
    font-size: var(--text-sm);
    font-style: italic;
  }

  .faqs__action {
    display: flex;
    justify-content: center;
    margin-block-start: var(--space-2xl);
  }
</style>
