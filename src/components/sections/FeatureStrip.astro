---
/**
 * FRANJA DE DESTINO
 * =============================================================================
 * Panel claro que solapa el cierre del hero y encadena la fotografía con el
 * contenido. Resume por qué Ica merece el viaje: son rasgos del destino
 * (comprobables), no características del inmueble sin confirmar.
 */
import Icon from '../ui/Icon.astro';

interface Props {
  items?: { icon: string; title: string; detail: string }[];
  signature?: string;
  class?: string;
}

const {
  items = [
    { icon: 'leaf', title: 'Naturaleza', detail: 'Desierto y oasis' },
    { icon: 'sun', title: 'Clima cálido', detail: 'Casi todo el año' },
    { icon: 'mountain', title: 'Dunas y aventura', detail: 'Huacachina' },
    { icon: 'wine', title: 'Viñedos', detail: 'Bodegas de pisco' },
  ],
  signature = 'Vive Ica',
  class: className,
  ...rest
} = Astro.props;
---

<section class:list={['strip', className]} aria-label="El entorno de Casa Blanco" {...rest}>
  <div class="strip__container">
    <div class="strip__panel">
      <ul class="strip__list" role="list">
        {
          items.map((item) => (
            <li class="strip__item">
              <span class="strip__icon">
                <Icon name={item.icon} size={20} />
              </span>
              <span class="strip__body">
                <span class="strip__title">{item.title}</span>
                <span class="strip__detail">{item.detail}</span>
              </span>
            </li>
          ))
        }
      </ul>

      <p class="script strip__signature">
        {signature}
        <span class="strip__rule" aria-hidden="true"></span>
      </p>
    </div>
  </div>
</section>

<style>
  .strip {
    position: relative;
    z-index: var(--z-raised);
    /* Solapa la curva del hero: la transición se lee como una sola pieza. */
    margin-block-start: calc(var(--space-2xl) * -1);
  }

  .strip__container {
    width: 100%;
    max-width: var(--container-wide);
    margin-inline: auto;
    padding-inline: var(--gutter);
  }

  .strip__panel {
    display: grid;
    gap: var(--space-lg);
    padding: var(--space-lg);
    border: 1px solid var(--color-border);
    border-radius: var(--radius-xl);
    background-color: var(--color-surface);
    box-shadow: var(--shadow-lg);
  }

  .strip__list {
    display: grid;
    /* En pantallas estrechas una sola columna: el texto no se parte en tres
       líneas y cada rasgo se lee de un vistazo. */
    gap: var(--space-md);
    margin: 0;
    padding: 0;
    list-style: none;
  }

  .strip__item {
    display: flex;
    align-items: center;
    gap: var(--space-sm);
  }

  .strip__icon {
    display: grid;
    place-items: center;
    flex-shrink: 0;
    width: 2.75rem;
    height: 2.75rem;
    border-radius: var(--radius-pill);
    background-color: var(--color-primary-soft);
    color: var(--color-primary);
  }

  .strip__body {
    display: flex;
    flex-direction: column;
    line-height: 1.3;
    min-width: 0;
  }

  .strip__title {
    font-size: var(--text-body-sm);
    font-weight: var(--weight-medium);
  }

  .strip__detail {
    font-size: var(--text-sm);
    color: var(--color-text-muted);
  }

  .strip__signature {
    display: flex;
    align-items: center;
    gap: var(--space-sm);
    font-size: 1.6rem;
    color: var(--color-primary);
  }

  .strip__rule {
    flex: 1;
    max-width: 3.5rem;
    height: 1px;
    background-color: var(--color-border-strong);
  }

  @media (min-width: 30rem) {
    .strip__list {
      grid-template-columns: repeat(2, minmax(0, 1fr));
      gap: var(--space-lg) var(--space-md);
    }
  }

  @media (min-width: 48rem) {
    .strip__panel {
      grid-template-columns: minmax(0, 1fr) auto;
      align-items: center;
      gap: var(--space-2xl);
      padding: var(--space-xl) var(--space-2xl);
    }

    .strip__list {
      grid-template-columns: repeat(4, minmax(0, 1fr));
      gap: var(--space-lg);
    }

    .strip__item + .strip__item {
      padding-inline-start: var(--space-lg);
      border-inline-start: 1px solid var(--color-border);
    }
  }
</style>
