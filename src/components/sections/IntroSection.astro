---
/**
 * CAPÍTULO EDITORIAL DE PRESENTACIÓN
 * =============================================================================
 * Composición asimétrica: una fotografía vertical grande, una segunda imagen
 * que la solapa en pantallas amplias y, al lado, el texto de la casa con sus
 * rasgos verificables (todos visibles en las fotografías reales).
 */
import { exploreHref } from '../../config/navigation.js';
import type { GalleryImage } from '../../types/content.js';
import PropertyImage from '../media/PropertyImage.astro';
import Button from '../ui/Button.astro';
import Chapter from '../ui/Chapter.astro';
import Container from '../ui/Container.astro';
import Icon from '../ui/Icon.astro';
import Section from '../ui/Section.astro';
import { withBase } from '../../lib/utils/url.js';

interface Props {
  primaryImage: GalleryImage;
  secondaryImage: GalleryImage;
  title: string;
  highlights: { id: string; title: string; description: string; icon: string }[];
  paragraphs: string[];
}

const { primaryImage, secondaryImage, title, highlights, paragraphs } = Astro.props;

/** Los párrafos admiten enlaces internos escritos a mano (`href="/..."`). */
const resolvedParagraphs = paragraphs.map((paragraph) =>
  paragraph.replace(/href="(\/[^"]*)"/g, (_match, path) => `href="${withBase(path)}"`),
);
---

<Section id="la-casa" tone="default" container="none" aria-labelledby="intro-title">
  <Container size="wide">
    <div class="intro">
      <div class="intro__media">
        <PropertyImage
          image={primaryImage}
          ratio="4 / 5"
          sizes="(min-width: 64rem) 40vw, 92vw"
          class="intro__image intro__image--primary"
        />
        <PropertyImage
          image={secondaryImage}
          ratio="1 / 1"
          sizes="(min-width: 64rem) 18vw, 55vw"
          class="intro__image intro__image--secondary"
        />
        <p class="intro__caption" aria-hidden="true">
          <span class="script">Casa Leblanc</span>
          <span>Ica · Perú</span>
        </p>
      </div>

      <div class="intro__text">
        <Chapter index="01" eyebrow="La casa" title={title} id="intro-title" titleWidth="16ch" />

        <div class="prose intro__prose">
          {resolvedParagraphs.map((paragraph) => <p set:html={paragraph} />)}
        </div>

        <ul class="signature" role="list">
          {
            highlights.map((item) => (
              <li class="signature__item">
                <Icon name={item.icon} size={20} class="signature__icon" />
                <div>
                  <h3 class="signature__title">{item.title}</h3>
                  <p class="signature__text">{item.description}</p>
                </div>
              </li>
            ))
          }
        </ul>

        <div class="intro__actions">
          <Button href={exploreHref} variant="primary" icon="arrow-right">
            Recorrer la casa
          </Button>
          <Button href="/galeria" variant="link" icon="arrow-right">Ver todas las fotos</Button>
        </div>
      </div>
    </div>
  </Container>
</Section>

<style>
  .intro {
    display: grid;
    gap: var(--space-3xl);
  }

  .intro__media {
    position: relative;
    padding-block-end: var(--space-3xl);
  }

  .intro__media .intro__image--primary {
    width: 86%;
  }

  /* Doble clase: gana a `.frame { position: relative }` de PropertyImage. */
  .intro__media .intro__image--secondary {
    position: absolute;
    inset-block-end: 0;
    inset-inline-end: 0;
    width: 44%;
    outline: 8px solid var(--color-background);
  }

  .intro__caption {
    position: absolute;
    inset-block-start: var(--space-md);
    inset-inline-end: 0;
    display: flex;
    flex-direction: column;
    align-items: flex-end;
    gap: var(--space-3xs);
    font-size: var(--text-2xs);
    font-weight: var(--weight-semibold);
    letter-spacing: var(--tracking-widest);
    text-transform: uppercase;
    color: var(--color-text-muted);
    writing-mode: vertical-rl;
  }

  .intro__caption .script {
    font-size: 1.25rem;
    letter-spacing: 0;
    text-transform: none;
    color: var(--color-text);
  }

  .intro__prose {
    margin-block-start: var(--space-xl);
  }

  .intro__prose :global(p) {
    font-size: var(--text-body);
  }

  .signature {
    display: grid;
    gap: var(--space-lg);
    margin-block-start: var(--space-2xl);
    padding: var(--space-xl) 0 0;
    border-block-start: 1px solid var(--color-border);
    list-style: none;
  }

  .signature__item {
    display: grid;
    grid-template-columns: auto 1fr;
    gap: var(--space-md);
    align-items: start;
  }

  .signature :global(.signature__icon) {
    margin-block-start: 0.15rem;
    color: var(--color-accent-strong);
  }

  .signature__title {
    font-family: var(--font-body);
    font-size: var(--text-body-sm);
    font-weight: var(--weight-semibold);
    letter-spacing: 0;
    line-height: var(--leading-snug);
  }

  .signature__text {
    margin-block-start: var(--space-3xs);
    font-size: var(--text-body-sm);
    line-height: var(--leading-normal);
    color: var(--color-text-muted);
  }

  .intro__actions {
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    gap: var(--space-md) var(--space-xl);
    margin-block-start: var(--space-2xl);
  }

  @media (min-width: 40rem) {
    .signature {
      grid-template-columns: repeat(2, minmax(0, 1fr));
      column-gap: var(--space-xl);
    }
  }

  @media (min-width: 64rem) {
    .intro {
      grid-template-columns: minmax(0, 1fr) minmax(0, 1fr);
      gap: clamp(3rem, 6vw, 7rem);
      align-items: center;
    }
  }
</style>
