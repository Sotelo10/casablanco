---
/**
 * CAPÍTULO DE ENTORNO — VIVIR ICA
 * =============================================================================
 * Sobre azul profundo: a la izquierda el titular y una fotografía real de la
 * casa ("volver a casa"); a la derecha, una lista editorial numerada de
 * lugares de la región, con distancias aproximadas desde el centro de Ica.
 *
 * Los destinos no se ilustran con fotos de la casa (sería engañoso) ni con
 * imágenes de stock: la lista tipográfica es honesta y ligera.
 */
import { photoBySlug } from '../../data/gallery.js';
import type { NearbyPlace } from '../../types/content.js';
import PropertyImage from '../media/PropertyImage.astro';
import Button from '../ui/Button.astro';
import Container from '../ui/Container.astro';
import Icon from '../ui/Icon.astro';
import Section from '../ui/Section.astro';

interface Props {
  places: NearbyPlace[];
  index?: string;
  title?: string;
  description?: string;
  actionHref?: string | null;
  actionLabel?: string;
  /** Nivel del titular de la sección (h1 si la página no tiene otro). */
  headingLevel?: 'h2' | 'h3';
}

const {
  places,
  index = '04',
  title = 'Ica, entre dunas, viñedos y el oasis de Huacachina',
  description = 'Casa Leblanc es una base cómoda para recorrer la región: el desierto y las bodegas de día, la piscina y la calma de la casa al volver.',
  actionHref = '/experiencia',
  actionLabel = 'Qué hacer en Ica',
  headingLevel: Heading = 'h3',
} = Astro.props;

const image = photoBySlug('piscina-jardin-alojamiento-ica');
---

<Section tone="deep" container="none" aria-labelledby="entorno-title" class="experience">
  <Container size="wide">
    <div class="experience__layout">
      <div class="experience__intro">
        <p class="experience__meta">
          <span class="numeral" aria-hidden="true">{index}</span>
          <span class="eyebrow eyebrow--plain">Experiencia</span>
        </p>
        <h2 id="entorno-title" class="experience__title">{title}</h2>
        <p class="experience__description">{description}</p>

        <PropertyImage
          image={image}
          ratio="4 / 3"
          sizes="(min-width: 64rem) 36vw, 100vw"
          class="experience__image"
        />
        <p class="experience__caption">De vuelta en casa: la piscina iluminada al caer la noche.</p>

        {
          actionHref && (
            <Button href={actionHref} variant="outline-light" icon="arrow-right" class="experience__action">
              {actionLabel}
            </Button>
          )
        }
      </div>

      <ol class="places" role="list">
        {
          places.map((place, i) => (
            <li class="place">
              <span class="place__number" aria-hidden="true">
                {String(i + 1).padStart(2, '0')}
              </span>
              <div>
                <Heading class="place__name">{place.name}</Heading>
                <p class="place__text">{place.description}</p>
                {place.distance && (
                  <p class="place__distance">
                    <Icon name="map-pin" size={14} />
                    {place.distance}
                  </p>
                )}
              </div>
            </li>
          ))
        }
      </ol>
    </div>

    <p class="experience__note">
      Distancias aproximadas desde el centro de Ica. Ninguno de estos lugares forma parte de la
      propiedad.
    </p>
  </Container>
</Section>

<style>
  .experience__layout {
    display: grid;
    gap: var(--space-3xl);
  }

  .experience__meta {
    display: flex;
    align-items: center;
    gap: var(--space-sm);
  }

  .experience__meta .numeral {
    color: var(--color-text-inverse-muted);
  }

  .experience__meta .eyebrow {
    color: var(--color-accent-light);
  }

  .experience__title {
    margin-block-start: var(--space-md);
    max-width: 16ch;
    font-size: var(--text-h2);
  }

  .experience__description {
    margin-block-start: var(--space-lg);
    max-width: 46ch;
    line-height: var(--leading-relaxed);
    color: var(--color-text-inverse-muted);
  }

  .experience__intro :global(.experience__image) {
    margin-block-start: var(--space-2xl);
  }

  .experience__caption {
    margin-block-start: var(--space-sm);
    font-family: var(--font-heading);
    font-size: 1.125rem;
    font-style: italic;
    color: var(--color-text-inverse-muted);
  }

  .experience__intro :global(.experience__action) {
    margin-block-start: var(--space-xl);
  }

  .places {
    margin: 0;
    padding: 0;
    list-style: none;
    border-block-start: 1px solid var(--color-border-inverse);
  }

  .place {
    display: grid;
    grid-template-columns: 3rem 1fr;
    gap: var(--space-md);
    padding-block: var(--space-lg);
    border-block-end: 1px solid var(--color-border-inverse);
  }

  .place__number {
    font-family: var(--font-heading);
    font-size: 1.5rem;
    font-style: italic;
    line-height: 1.2;
    color: var(--color-accent-light);
  }

  .place__name {
    font-family: var(--font-heading);
    font-size: clamp(1.375rem, 1.2rem + 0.6vw, 1.75rem);
    font-weight: var(--weight-heading);
    line-height: 1.2;
    color: var(--color-text-inverse);
  }

  .place__text {
    margin-block-start: var(--space-xs);
    max-width: 52ch;
    font-size: var(--text-body-sm);
    line-height: var(--leading-normal);
    color: var(--color-text-inverse-muted);
  }

  .place__distance {
    display: inline-flex;
    align-items: center;
    gap: var(--space-2xs);
    margin-block-start: var(--space-sm);
    font-size: var(--text-2xs);
    font-weight: var(--weight-semibold);
    letter-spacing: var(--tracking-wide);
    text-transform: uppercase;
    color: var(--color-accent-light);
  }

  .experience__note {
    margin-block-start: var(--space-2xl);
    font-size: var(--text-sm);
    color: var(--color-text-inverse-muted);
  }

  @media (min-width: 64rem) {
    .experience__layout {
      grid-template-columns: minmax(0, 5fr) minmax(0, 7fr);
      gap: clamp(3rem, 7vw, 7rem);
      align-items: start;
    }

    .experience__intro {
      position: sticky;
      top: calc(var(--header-height) + var(--space-xl));
    }
  }
</style>
