---
/**
 * CAPÍTULO DE UBICACIÓN
 * =============================================================================
 * Mapa (o su marcador) junto a los datos de acceso. Refuerza la confianza:
 * el visitante ve dónde está la casa y cómo llegar antes de escribir.
 */
import { brand } from '../../config/brand.js';
import { nearbyPlaces } from '../../data/nearby.js';
import { googleDirectionsLink, googleMapsZoneLink } from '../../lib/utils/maps.js';
import LocationMap from '../location/LocationMap.astro';
import Button from '../ui/Button.astro';
import Chapter from '../ui/Chapter.astro';
import Container from '../ui/Container.astro';
import Icon from '../ui/Icon.astro';
import Section from '../ui/Section.astro';

interface Props {
  index?: string;
  tone?: 'default' | 'surface' | 'muted';
  title?: string;
  /** Muestra las referencias turísticas cercanas. */
  showReferences?: boolean;
}

const {
  index = '06',
  tone = 'default',
  title = 'Tu próxima experiencia comienza aquí.',
  showReferences = true,
} = Astro.props;
/** Indicaciones hasta la casa: sólo existe con dirección o coordenadas reales. */
const directions = googleDirectionsLink();
/** Mientras tanto, la zona de Huacachina (rotulada como tal). */
const zone = googleMapsZoneLink();

/** Referencias turísticas reales de la región, sin distancias desde la casa. */
const references = nearbyPlaces.filter((place) =>
  ['huacachina', 'dunas', 'bodegas', 'plaza-de-armas', 'paracas', 'nasca'].includes(place.id),
);

const points = [
  {
    icon: 'car',
    title: 'Llegada en auto',
    text: 'Ica conecta con Lima y el sur por la Panamericana Sur. Compartimos las indicaciones de acceso al confirmar la reserva.',
  },
  {
    icon: 'map-pin',
    title: 'Punto de encuentro',
    text: 'Te enviamos la dirección exacta y una referencia visual antes de tu llegada, para que no tengas que buscar.',
  },
  {
    icon: 'clock',
    title: 'Coordinación del ingreso',
    text: 'Acordamos contigo la hora de entrada y quién te recibe, sin recepción ni esperas.',
  },
];
---

<Section tone={tone} container="none" aria-labelledby="ubicacion-title">
  <Container size="wide">
    <Chapter
      index={index}
      eyebrow="Ubicación"
      title={title}
      id="ubicacion-title"
      actionHref="/ubicacion"
      actionLabel="Ver ubicación y accesos"
      titleWidth="18ch"
    />

    <div class="location">
      <LocationMap class="location__map" ratio="4 / 3" />

      <div class="location__body">
        <p class="location__address">
          <Icon name="map-pin" size={18} />
          {brand.locationLine.replace(/ · /g, ', ')}
        </p>
        <p class="location__note">
          La dirección exacta y las referencias para llegar se comparten al confirmar la reserva.
        </p>

        <ul class="location__points" role="list">
          {
            points.map((point) => (
              <li class="location__point">
                <span class="location__point-icon">
                  <Icon name={point.icon} size={16} />
                </span>
                <div>
                  <h3 class="location__point-title">{point.title}</h3>
                  <p class="location__point-text">{point.text}</p>
                </div>
              </li>
            ))
          }
        </ul>

        {
          showReferences && (
            <div class="location__refs">
              <h3 class="location__refs-title">Referencias cercanas</h3>
              <ul class="location__refs-list" role="list">
                {references.map((place) => (
                  <li>
                    <Icon name={place.icon} size={15} />
                    {place.name}
                  </li>
                ))}
              </ul>
            </div>
          )
        }

        <div class="location__actions">
          {
            directions ? (
              <Button href={directions} variant="primary" leadingIcon="map-pin" external>
                Obtener indicaciones
              </Button>
            ) : (
              zone && (
                <Button href={zone} variant="primary" leadingIcon="map-pin" external>
                  Ver Huacachina en el mapa
                </Button>
              )
            )
          }
          <Button href="/ubicacion" variant="link" icon="arrow-right">Cómo llegar</Button>
        </div>
      </div>
    </div>
  </Container>
</Section>

<style>
  .location {
    display: grid;
    gap: var(--space-xl);
  }

  .location__map :global(.map) {
    border-radius: var(--radius-lg);
    box-shadow: var(--shadow-md);
  }

  .location__address {
    display: flex;
    align-items: center;
    gap: var(--space-xs);
    font-family: var(--font-heading);
    font-size: var(--text-h3);
  }

  .location__address :global(svg) {
    color: var(--color-primary);
  }

  .location__note {
    margin-block-start: var(--space-xs);
    max-width: 44ch;
    font-size: var(--text-body-sm);
    color: var(--color-text-muted);
  }

  .location__points {
    display: grid;
    gap: var(--space-md);
    margin-block-start: var(--space-xl);
    padding-block-start: var(--space-lg);
    border-block-start: 1px solid var(--color-border);
    list-style: none;
    padding-inline: 0;
  }

  .location__point {
    display: flex;
    align-items: flex-start;
    gap: var(--space-sm);
  }

  .location__point-icon {
    display: grid;
    place-items: center;
    flex-shrink: 0;
    width: 2.25rem;
    height: 2.25rem;
    border-radius: var(--radius-pill);
    background-color: var(--color-primary-soft);
    color: var(--color-primary);
  }

  .location__point-title {
    font-family: var(--font-body);
    font-size: var(--text-body-sm);
    font-weight: var(--weight-semibold);
    letter-spacing: var(--tracking-normal);
  }

  .location__point-text {
    margin-block-start: 0.15rem;
    max-width: 46ch;
    font-size: var(--text-body-sm);
    line-height: var(--leading-relaxed);
    color: var(--color-text-muted);
  }

  .location__refs {
    margin-block-start: var(--space-xl);
  }

  .location__refs-title {
    font-family: var(--font-body);
    font-size: var(--text-2xs);
    font-weight: var(--weight-semibold);
    letter-spacing: var(--tracking-widest);
    text-transform: uppercase;
    color: var(--color-text-muted);
  }

  .location__refs-list {
    display: flex;
    flex-wrap: wrap;
    gap: var(--space-xs);
    margin-block-start: var(--space-sm);
    padding: 0;
    list-style: none;
  }

  .location__refs-list li {
    display: inline-flex;
    align-items: center;
    gap: 0.4rem;
    padding: 0.45rem 0.8rem;
    border: 1px solid var(--color-border);
    border-radius: var(--radius-pill);
    font-size: var(--text-sm);
    color: var(--color-text-soft);
  }

  .location__refs-list :global(svg) {
    color: var(--color-primary);
  }

  .location__actions {
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    gap: var(--space-md);
    margin-block-start: var(--space-xl);
  }

  @media (min-width: 64rem) {
    .location {
      grid-template-columns: minmax(0, 1.05fr) minmax(0, 1fr);
      gap: var(--space-3xl);
      align-items: center;
    }
  }
</style>
