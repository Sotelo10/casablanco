---
/**
 * TELÓN DEL HERO
 * =============================================================================
 * Fondo del hero mientras no exista la fotografía definitiva.
 *
 * No es una caja de relleno: compone el cielo de Ica con degradados (azul
 * profundo arriba a la izquierda, luz en el horizonte a la derecha) y el arco
 * de la marca, de modo que el hero se sostiene visualmente desde el primer día.
 * Al añadir la foto real, este componente desaparece y la composición no cambia.
 */
interface Props {
  /** Ficha de la toma que ocupará este lugar. */
  label: string;
  class?: string;
}

const { label, class: className, ...rest } = Astro.props;
---

<div class:list={['backdrop', className]} aria-hidden="true" {...rest}>
  <div class="backdrop__sky"></div>
  <div class="backdrop__glow"></div>
  <div class="backdrop__horizon"></div>

  <svg class="backdrop__arch" viewBox="0 0 200 160" preserveAspectRatio="xMidYMax meet" focusable="false">
    <path d="M55 160V78a45 45 0 0 1 90 0v82" fill="none" stroke="currentColor" stroke-width="1.1" />
    <path
      d="M78 160V83a22 22 0 0 1 44 0v77"
      fill="none"
      stroke="currentColor"
      stroke-width="1.1"
      opacity="0.6"
    />
  </svg>

  <p class="backdrop__label">{label}</p>
</div>

<style>
  .backdrop {
    position: absolute;
    inset: 0;
    overflow: hidden;
    background-color: var(--sky-800);
  }

  /* Cielo: de azul profundo en el ángulo superior izquierdo a luz en el
     horizonte inferior derecho. */
  .backdrop__sky {
    position: absolute;
    inset: 0;
    background: linear-gradient(
      148deg,
      var(--sky-900) 0%,
      var(--sky-800) 26%,
      var(--sky-600) 58%,
      var(--sky-400) 82%,
      var(--sky-200) 100%
    );
  }

  .backdrop__glow {
    position: absolute;
    inset: 0;
    background: radial-gradient(
      70% 60% at 82% 26%,
      rgb(var(--white-rgb) / 42%) 0%,
      rgb(var(--white-rgb) / 10%) 42%,
      transparent 70%
    );
  }

  /* Bruma baja: insinúa el horizonte del desierto sin dibujarlo. */
  .backdrop__horizon {
    position: absolute;
    inset-block-end: 0;
    inset-inline: 0;
    height: 42%;
    background: linear-gradient(
      to top,
      rgb(var(--white-rgb) / 30%) 0%,
      rgb(var(--white-rgb) / 8%) 45%,
      transparent 100%
    );
  }

  .backdrop__arch {
    position: absolute;
    inset-block-end: -6%;
    inset-inline-end: 6%;
    width: min(42%, 30rem);
    height: auto;
    color: rgb(var(--white-rgb) / 26%);
  }

  .backdrop__label {
    position: absolute;
    inset-block-end: clamp(3.5rem, 7vw, 6rem);
    inset-inline-end: var(--gutter);
    font-family: var(--font-mono);
    font-size: var(--text-2xs);
    letter-spacing: var(--tracking-wide);
    text-transform: uppercase;
    color: rgb(var(--white-rgb) / 62%);
  }

  @media (max-width: 47.99rem) {
    .backdrop__label {
      display: none;
    }
  }
</style>
