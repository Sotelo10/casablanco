---
/**
 * HERO CINEMATOGRÁFICO
 * =============================================================================
 * Vídeo apaisado a sangre (movimiento de cámara lento sobre la fotografía
 * nocturna de la casa) con un velo azul noche que garantiza la legibilidad.
 * La composición es centrada y sobria: marca, localización, lema, promesa y
 * dos acciones.
 *
 * RENDIMIENTO Y ACCESIBILIDAD
 * - El LCP es el póster (`<picture>` WebP + JPG, prioridad alta). Es el primer
 *   fotograma del vídeo, así que el fundido al empezar a reproducir no se nota.
 * - El vídeo no lleva `src` en el HTML: un script mínimo lo asigna cuando la
 *   página ya cargó, eligiendo la versión 960 px en pantallas pequeñas.
 * - No se carga con `prefers-reduced-motion: reduce` ni con ahorro de datos;
 *   se pausa fuera de pantalla y con la pestaña oculta.
 * - Sin JavaScript, sin vídeo o si falla la carga, queda la fotografía.
 */
import { brand } from '../../config/brand.js';
import { bookingHref, bookingLabel, exploreLabel } from '../../config/navigation.js';
import { site } from '../../config/site.js';
import { heroMedia, heroPosterSrcset } from '../../data/hero.js';
import Button from '../ui/Button.astro';

interface Props {
  /** Destino de "Explorar la casa": un ancla de la portada o una página. */
  exploreHref?: string;
  /** Ancla del botón de desplazamiento. */
  scrollTarget?: string;
}

const { exploreHref = '#la-casa', scrollTarget = '#la-casa' } = Astro.props;
const { video, poster } = heroMedia;
---

<section class="hero" aria-labelledby="hero-title">
  <div class="hero__media" aria-hidden="true">
    <picture>
      <source type="image/webp" srcset={heroPosterSrcset} sizes="100vw" />
      <img
        class="hero__poster"
        src={poster.fallback}
        width={poster.width}
        height={poster.height}
        alt=""
        fetchpriority="high"
        decoding="async"
      />
    </picture>
    {
      video && (
        <video
          class="hero__video"
          data-hero-video
          data-desktop-webm={video.desktop.webm}
          data-desktop-mp4={video.desktop.mp4}
          data-mobile-webm={video.mobile.webm}
          data-mobile-mp4={video.mobile.mp4}
          width={poster.width}
          height={poster.height}
          muted
          loop
          playsinline
          disablepictureinpicture
          preload="none"
          tabindex="-1"
        />
      )
    }
    <div class="hero__veil"></div>
  </div>

  {/* La fotografía es decorativa para el lector de pantalla: se describe aquí. */}
  <p class="visually-hidden">{poster.alt}</p>

  <div class="hero__content">
    <h1 class="hero__heading" id="hero-title">
      <span class="hero__brand">{site.name}</span>
      <span class="hero__location">
        <span class="hero__rule" aria-hidden="true"></span>
        <span>{brand.locationLine}</span>
        <span class="hero__rule" aria-hidden="true"></span>
      </span>
      <span class="hero__title">
        <span>Una casa.</span> <em>Infinitas experiencias.</em>
      </span>
    </h1>

    <p class="hero__lead">{brand.promise}</p>

    <div class="hero__actions">
      <Button href={exploreHref} variant="glass" size="lg" icon="arrow-right" class="hero__btn">
        {exploreLabel}
      </Button>
      <Button href={bookingHref} variant="primary" size="lg" leadingIcon="calendar" class="hero__btn hero__btn--primary">
        {bookingLabel}
      </Button>
    </div>
  </div>

  <a class="hero__scroll" href={scrollTarget}>
    <span class="hero__scroll-label">Descubre</span>
    <span class="hero__scroll-line" aria-hidden="true"></span>
  </a>
</section>

<script>
  const video = document.querySelector<HTMLVideoElement>('[data-hero-video]');

  if (video) {
    const connection = (
      navigator as Navigator & { connection?: { saveData?: boolean; effectiveType?: string } }
    ).connection;
    const motionQuery = window.matchMedia('(prefers-reduced-motion: reduce)');
    const slow = connection?.saveData || /(^|-)2g$/.test(connection?.effectiveType ?? '');

    let started = false;
    let visible = true;

    const play = () => {
      if (!started || motionQuery.matches || document.hidden || !visible) return;
      video.play().catch(() => {
        /* Autoplay bloqueado (p. ej. modo de bajo consumo en iOS): queda el póster. */
      });
    };

    const start = () => {
      if (started || motionQuery.matches) return;
      started = true;
      const size = window.matchMedia('(min-width: 48rem)').matches ? 'desktop' : 'mobile';
      const webm = video.canPlayType('video/webm; codecs="vp9"') !== '';
      const mp4 = video.canPlayType('video/mp4; codecs="avc1.640028"') !== '';
      const src = webm
        ? video.dataset[`${size}Webm`]
        : mp4
          ? video.dataset[`${size}Mp4`]
          : undefined;
      if (!src) return;

      video.addEventListener('playing', () => video.classList.add('is-playing'), { once: true });
      video.addEventListener('error', () => video.remove(), { once: true });
      video.src = src;
      play();
    };

    if (!slow) {
      const idle = (window as Window & { requestIdleCallback?: (cb: () => void) => void })
        .requestIdleCallback;
      const schedule = () => (idle ? idle(start) : setTimeout(start, 200));
      if (document.readyState === 'complete') schedule();
      else window.addEventListener('load', schedule, { once: true });
    }

    // Ahorro de batería: sólo se reproduce mientras el hero está a la vista.
    new IntersectionObserver(([entry]) => {
      visible = Boolean(entry?.isIntersecting);
      if (visible) play();
      else video.pause();
    }).observe(video);

    document.addEventListener('visibilitychange', () => {
      if (document.hidden) video.pause();
      else play();
    });

    // Si el visitante activa "reducir movimiento" con la página abierta.
    motionQuery.addEventListener('change', () => {
      if (motionQuery.matches) {
        video.pause();
        video.classList.remove('is-playing');
      } else if (started) {
        video.classList.add('is-playing');
        play();
      } else {
        start();
      }
    });
  }
</script>

<style>
  .hero {
    position: relative;
    display: grid;
    place-items: center;
    min-height: max(34rem, 100svh);
    padding-block: calc(var(--header-height) + var(--space-2xl)) calc(var(--space-4xl) + var(--space-lg));
    padding-inline: var(--gutter);
    overflow: hidden;
    color: var(--color-text-inverse);
    text-align: center;
    background-color: rgb(var(--veil-rgb));
    isolation: isolate;
  }

  /* ── Medios ──────────────────────────────────────────────────────────── */
  .hero__media {
    position: absolute;
    inset: 0;
    z-index: -1;
  }

  .hero__poster,
  .hero__video {
    position: absolute;
    inset: 0;
    width: 100%;
    height: 100%;
    object-fit: cover;
    /* En vertical se recorta hacia la sala y la piscina, el corazón de la casa. */
    object-position: 62% 55%;
  }

  .hero__video {
    opacity: 0;
    transition: opacity 1200ms var(--ease-out);
  }

  .hero__video.is-playing {
    opacity: 1;
  }

  /* Velo: oscurece de forma pareja el centro (donde vive el texto), refuerza
     la franja superior bajo la cabecera y funde la base hacia la página. */
  .hero__veil {
    position: absolute;
    inset: 0;
    background:
      radial-gradient(
        ellipse 70% 60% at 50% 52%,
        rgb(var(--veil-rgb) / 52%) 0%,
        rgb(var(--veil-rgb) / 30%) 70%,
        rgb(var(--veil-rgb) / 18%) 100%
      ),
      linear-gradient(
        to bottom,
        rgb(var(--veil-rgb) / 62%) 0%,
        rgb(var(--veil-rgb) / 10%) 26%,
        rgb(var(--veil-rgb) / 6%) 58%,
        rgb(var(--veil-rgb) / 78%) 100%
      );
  }

  /* ── Contenido ───────────────────────────────────────────────────────── */
  .hero__content {
    display: flex;
    flex-direction: column;
    align-items: center;
    max-width: 62rem;
    text-shadow: 0 1px 24px rgb(var(--veil-rgb) / 45%);
  }

  .hero__heading {
    display: flex;
    flex-direction: column;
    align-items: center;
    font-weight: var(--weight-heading);
  }

  .hero__brand {
    font-family: var(--font-heading);
    font-size: clamp(1.375rem, 1rem + 1.6vw, 2.25rem);
    font-weight: var(--weight-semibold);
    line-height: 1;
    letter-spacing: 0.34em;
    /* Compensa el espaciado final para que el centrado óptico sea exacto. */
    margin-inline-end: -0.34em;
    text-transform: uppercase;
  }

  .hero__location {
    display: inline-flex;
    align-items: center;
    gap: var(--space-sm);
    margin-block-start: var(--space-md);
    font-family: var(--font-body);
    font-size: var(--text-2xs);
    font-weight: var(--weight-semibold);
    line-height: 1;
    letter-spacing: var(--tracking-widest);
    text-transform: uppercase;
    color: rgb(var(--white-rgb) / 86%);
  }

  .hero__rule {
    display: block;
    width: clamp(1.5rem, 4vw, 3rem);
    height: 1px;
    background-color: rgb(var(--white-rgb) / 55%);
  }

  .hero__title {
    display: block;
    margin-block-start: clamp(1.5rem, 1rem + 2vw, 2.5rem);
    font-family: var(--font-heading);
    font-size: clamp(2.75rem, 1.4rem + 5.6vw, 6.5rem);
    font-weight: var(--weight-heading);
    line-height: 0.98;
    letter-spacing: var(--tracking-tighter);
    text-wrap: balance;
  }

  .hero__title > * {
    display: block;
  }

  .hero__title em {
    font-style: italic;
    color: rgb(var(--white-rgb) / 94%);
  }

  .hero__lead {
    margin-block-start: var(--space-lg);
    max-width: 40ch;
    font-size: var(--text-lead);
    line-height: var(--leading-normal);
    color: rgb(var(--white-rgb) / 88%);
    text-wrap: balance;
  }

  .hero__actions {
    display: flex;
    flex-wrap: wrap;
    justify-content: center;
    gap: var(--space-sm);
    margin-block-start: var(--space-2xl);
    text-shadow: none;
  }

  /* ── Indicador de desplazamiento ─────────────────────────────────────── */
  .hero__scroll {
    position: absolute;
    inset-block-end: var(--space-lg);
    inset-inline-start: 50%;
    display: flex;
    flex-direction: column;
    align-items: center;
    gap: var(--space-xs);
    min-width: 2.75rem;
    padding: var(--space-xs);
    font-size: var(--text-3xs);
    font-weight: var(--weight-semibold);
    letter-spacing: var(--tracking-widest);
    text-transform: uppercase;
    text-decoration: none;
    color: rgb(var(--white-rgb) / 78%);
    transform: translateX(-50%);
  }

  .hero__scroll:hover {
    color: var(--color-text-inverse);
  }

  .hero__scroll-line {
    display: block;
    width: 1px;
    height: 2.75rem;
    background: linear-gradient(to bottom, rgb(var(--white-rgb) / 80%), transparent);
  }

  /* ── Móvil: botones a todo el ancho, ritmo más compacto ─────────────── */
  @media (max-width: 29.99rem) {
    .hero__actions {
      flex-direction: column;
      align-self: stretch;
    }

    .hero__actions :global(.hero__btn) {
      width: 100%;
      justify-content: center;
    }

    .hero__location {
      letter-spacing: var(--tracking-wider);
    }
  }

  @media (min-width: 64rem) {
    .hero {
      min-height: max(40rem, min(100svh, 68rem));
    }
  }

  /* ── Entrada: aparición escalonada y discreta ────────────────────────── */
  @media (prefers-reduced-motion: no-preference) {
    .hero__brand,
    .hero__location,
    .hero__title,
    .hero__lead,
    .hero__actions {
      animation: hero-in 1100ms var(--ease-emphasis) both;
    }

    .hero__location {
      animation-delay: 120ms;
    }

    .hero__title {
      animation-delay: 240ms;
    }

    .hero__lead {
      animation-delay: 380ms;
    }

    .hero__actions {
      animation-delay: 500ms;
    }

    .hero__scroll-line {
      animation: scroll-hint 2.6s var(--ease-in-out) infinite;
      transform-origin: top;
    }

    @keyframes hero-in {
      from {
        opacity: 0;
        transform: translateY(14px);
      }

      to {
        opacity: 1;
        transform: none;
      }
    }

    @keyframes scroll-hint {
      0% {
        transform: scaleY(0);
      }

      50% {
        transform: scaleY(1);
      }

      100% {
        transform: scaleY(1);
        opacity: 0;
      }
    }
  }
</style>
