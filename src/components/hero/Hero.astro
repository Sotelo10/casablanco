---
/**
 * HERO CINEMATOGRÁFICO
 * =============================================================================
 * El vídeo real de la casa (recorrido nocturno por el patio, la piscina y la
 * fachada) es vertical, así que la composición se adapta a él:
 *
 * - Móvil y tablet: vídeo a sangre detrás del texto, con velo de contraste.
 * - Escritorio: composición editorial partida. Texto sobre azul profundo a la
 *   izquierda y el vídeo en un gran panel vertical a la derecha, sin ampliarlo
 *   más de lo que su resolución permite.
 *
 * RENDIMIENTO
 * El LCP es el póster (`<img>` WebP con prioridad alta). El vídeo no lleva
 * `src` en el HTML: un script mínimo lo carga cuando la página ya está
 * inactiva, y sólo si el visitante no pidió movimiento reducido ni ahorro de
 * datos. Sin JavaScript, o en conexiones lentas, queda el póster.
 */
import { bookingHref, bookingLabel, exploreHref } from '../../config/navigation.js';
import { formattedCity, site } from '../../config/site.js';
import { whatsAppUrl } from '../../lib/utils/whatsapp.js';
import Button from '../ui/Button.astro';
import Icon from '../ui/Icon.astro';

interface Props {
  video: {
    mp4: string;
    webm: string;
    poster: string;
    posterWidths: number[];
    width: number;
    height: number;
  } | null;
  posterAlt: string;
  eyebrow?: string;
  claim: string;
  lead: string;
  /** Características reales, visibles en las fotografías. */
  features: { icon: string; label: string }[];
}

const { video, posterAlt, eyebrow = 'Casa vacacional · Ica, Perú', claim, lead, features } =
  Astro.props;

const whatsapp = whatsAppUrl();
const place = [site.location.area, formattedCity()].filter(Boolean).join(' · ');
const posterSrcset = video
  ? video.posterWidths.map((w) => `${video.poster}-${w}.webp ${w}w`).join(', ')
  : '';
const posterSrc = video ? `${video.poster}-${video.posterWidths.at(-1)}.webp` : '';
---

<section class="hero" aria-labelledby="hero-title">
  <div class="hero__media">
    {
      video && (
        <>
          <img
            class="hero__poster"
            src={posterSrc}
            srcset={posterSrcset}
            sizes="(min-width: 64rem) 46vw, 100vw"
            width={video.width}
            height={video.height}
            alt={posterAlt}
            fetchpriority="high"
            decoding="async"
          />
          <video
            class="hero__video"
            data-hero-video
            data-mp4={video.mp4}
            data-webm={video.webm}
            width={video.width}
            height={video.height}
            muted
            loop
            playsinline
            preload="none"
            aria-hidden="true"
            tabindex="-1"
          />
        </>
      )
    }
    <div class="hero__scrim" aria-hidden="true"></div>
  </div>

  <div class="hero__inner">
    <div class="hero__content">
      <p class="eyebrow hero__eyebrow">{eyebrow}</p>

      <h1 class="hero__title" id="hero-title">
        <span class="hero__name">{site.name}</span>
        <span class="hero__claim">{claim}</span>
      </h1>

      <p class="hero__lead">{lead}</p>

      <div class="hero__actions">
        <Button href={bookingHref} variant="light" size="lg" leadingIcon="calendar">
          {bookingLabel}
        </Button>
        <Button href={exploreHref} variant="glass" size="lg" icon="arrow-right">
          Descubrir la casa
        </Button>
      </div>

      <ul class="hero__features" role="list" aria-label="Características de la casa">
        {
          features.map((feature) => (
            <li class="hero__feature">
              <Icon name={feature.icon} size={18} />
              <span>{feature.label}</span>
            </li>
          ))
        }
      </ul>

      <div class="hero__meta">
        <p class="hero__place">
          <Icon name="map-pin" size={16} />
          <span>{place}</span>
        </p>
        {
          whatsapp && (
            <a class="hero__whatsapp" href={whatsapp} target="_blank" rel="noopener noreferrer">
              <Icon name="whatsapp" size={16} />
              <span>
                WhatsApp <span class="hero__phone">{site.contact.phone}</span>
              </span>
            </a>
          )
        }
      </div>
    </div>
  </div>

  <a class="hero__scroll" href="#la-casa" aria-label="Ir a la presentación de la casa">
    <span class="hero__scroll-line" aria-hidden="true"></span>
  </a>
</section>

<script>
  const video = document.querySelector<HTMLVideoElement>('[data-hero-video]');

  if (video) {
    const connection = (
      navigator as Navigator & { connection?: { saveData?: boolean; effectiveType?: string } }
    ).connection;
    const reducedMotion = window.matchMedia('(prefers-reduced-motion: reduce)').matches;
    const slow = connection?.saveData || /(^|-)2g$/.test(connection?.effectiveType ?? '');

    if (!reducedMotion && !slow) {
      const start = () => {
        const sources: [string | undefined, string][] = [
          [video.dataset.webm, 'video/webm'],
          [video.dataset.mp4, 'video/mp4'],
        ];
        for (const [src, type] of sources) {
          if (!src) continue;
          const source = document.createElement('source');
          source.src = src;
          source.type = type;
          video.append(source);
        }
        video.addEventListener('playing', () => video.classList.add('is-playing'), { once: true });
        video.load();
        video.play().catch(() => {
          /* Autoplay bloqueado (p. ej. modo de bajo consumo en iOS): queda el póster. */
        });
      };

      const idle = (window as Window & { requestIdleCallback?: (cb: () => void) => void })
        .requestIdleCallback;
      const schedule = () => (idle ? idle(start) : setTimeout(start, 200));
      if (document.readyState === 'complete') schedule();
      else window.addEventListener('load', schedule, { once: true });
    }
  }
</script>

<style>
  .hero {
    position: relative;
    display: flex;
    align-items: flex-end;
    min-height: max(36rem, 100svh);
    padding-block: calc(var(--header-height) + var(--space-2xl)) var(--space-3xl);
    overflow: hidden;
    color: var(--color-text-inverse);
    background-color: var(--color-surface-deep);
    isolation: isolate;
  }

  .hero__media {
    position: absolute;
    inset: 0;
    z-index: -1;
    background-color: var(--color-surface-deep);
  }

  .hero__poster,
  .hero__video {
    position: absolute;
    inset: 0;
    width: 100%;
    height: 100%;
    object-fit: cover;
    object-position: 50% 60%;
  }

  .hero__video {
    opacity: 0;
    transition: opacity 900ms var(--ease-out);
  }

  .hero__video.is-playing {
    opacity: 1;
  }

  /* Velo: oscurece la parte baja, donde vive el texto, y la franja superior
     de la cabecera; el centro del vídeo respira. */
  .hero__scrim {
    position: absolute;
    inset: 0;
    background:
      linear-gradient(
        to top,
        rgb(var(--veil-rgb) / 96%) 0%,
        rgb(var(--veil-rgb) / 82%) 42%,
        rgb(var(--veil-rgb) / 40%) 72%,
        rgb(var(--veil-rgb) / 55%) 100%
      );
  }

  .hero__inner {
    width: 100%;
    max-width: var(--container-full);
    margin-inline: auto;
    padding-inline: var(--gutter);
  }

  .hero__content {
    max-width: 38rem;
  }

  .hero__eyebrow {
    color: var(--color-accent-light);
  }

  .hero__title {
    display: flex;
    flex-direction: column;
    gap: var(--space-xs);
    margin-block-start: var(--space-md);
  }

  .hero__name {
    font-size: var(--text-display);
    font-weight: var(--weight-heading);
    line-height: 0.9;
    letter-spacing: var(--tracking-tighter);
  }

  .hero__claim {
    font-family: var(--font-heading);
    font-size: clamp(1.375rem, 1.05rem + 1.4vw, 2.25rem);
    font-style: italic;
    font-weight: var(--weight-heading);
    line-height: 1.2;
    letter-spacing: 0;
    color: rgb(var(--white-rgb) / 90%);
  }

  .hero__lead {
    margin-block-start: var(--space-lg);
    max-width: 44ch;
    font-size: var(--text-body);
    line-height: var(--leading-relaxed);
    color: rgb(var(--white-rgb) / 84%);
  }

  .hero__actions {
    display: flex;
    flex-wrap: wrap;
    gap: var(--space-sm);
    margin-block-start: var(--space-xl);
  }

  .hero__features {
    display: flex;
    flex-wrap: wrap;
    gap: var(--space-sm) var(--space-lg);
    margin-block-start: var(--space-xl);
    padding: var(--space-lg) 0 0;
    border-block-start: 1px solid rgb(var(--white-rgb) / 18%);
    list-style: none;
  }

  .hero__feature {
    display: inline-flex;
    align-items: center;
    gap: var(--space-xs);
    font-size: var(--text-sm);
    font-weight: var(--weight-medium);
    color: rgb(var(--white-rgb) / 90%);
  }

  .hero__feature :global(svg) {
    color: var(--color-accent-light);
  }

  .hero__meta {
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    gap: var(--space-xs) var(--space-lg);
    margin-block-start: var(--space-lg);
    font-size: var(--text-sm);
    color: rgb(var(--white-rgb) / 76%);
  }

  .hero__place,
  .hero__whatsapp {
    display: inline-flex;
    align-items: center;
    gap: var(--space-xs);
  }

  .hero__whatsapp {
    min-height: 2.75rem;
    color: var(--color-text-inverse);
    text-decoration: none;
  }

  .hero__whatsapp:hover {
    color: var(--color-accent-light);
  }

  .hero__phone {
    font-variant-numeric: tabular-nums;
    color: rgb(var(--white-rgb) / 76%);
  }

  .hero__scroll {
    display: none;
  }

  /* ── Escritorio: composición partida ─────────────────────────────────── */
  @media (min-width: 64rem) {
    .hero {
      align-items: center;
      min-height: max(40rem, min(100svh, 62rem));
      padding-block: calc(var(--header-height) + var(--space-2xl)) var(--space-4xl);
    }

    .hero__media {
      inset: 0 0 0 auto;
      width: 46%;
    }

    .hero__scrim {
      background: linear-gradient(
        to right,
        var(--color-surface-deep) 0%,
        rgb(var(--veil-rgb) / 30%) 14%,
        rgb(var(--veil-rgb) / 0%) 40%
      ),
      linear-gradient(to bottom, rgb(var(--veil-rgb) / 40%) 0%, transparent 22%);
    }

    .hero__content {
      max-width: min(40rem, 50%);
    }

    .hero__scroll {
      position: absolute;
      inset-block-end: var(--space-xl);
      inset-inline-start: var(--gutter);
      display: grid;
      place-items: center;
      width: 2.75rem;
      height: 3.5rem;
    }

    .hero__scroll-line {
      display: block;
      width: 1px;
      height: 100%;
      background: linear-gradient(to bottom, rgb(var(--white-rgb) / 70%), transparent);
    }
  }

  @media (min-width: 64rem) and (prefers-reduced-motion: no-preference) {
    .hero__scroll-line {
      animation: scroll-hint 2.4s var(--ease-in-out) infinite;
      transform-origin: top;
    }

    @keyframes scroll-hint {
      0% {
        transform: scaleY(0);
      }

      50% {
        transform: scaleY(1);
      }

      100% {
        transform: scaleY(1);
        opacity: 0;
      }
    }
  }

  @media (min-width: 90rem) {
    .hero__media {
      width: 44%;
    }
  }
</style>
