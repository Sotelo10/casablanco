---
/**
 * PIE DE PÁGINA
 * =============================================================================
 * Cierra el sitio con la marca, la navegación completa y los datos NAP
 * (nombre · dirección · teléfono) consistentes con los datos estructurados:
 * es una señal directa de SEO local y de confianza.
 *
 * Todo sale de `src/config/site.ts`. No se muestra ningún enlace ni dato que no
 * esté configurado.
 */
import { bookingHref, bookingLabel, legalNav, mainNav, secondaryNav } from '../../config/navigation.js';
import { formattedAddress, site } from '../../config/site.js';
import { googleMapsLink } from '../../lib/utils/maps.js';
import { withBase } from '../../lib/utils/url.js';
import { whatsAppUrl } from '../../lib/utils/whatsapp.js';
import Button from '../ui/Button.astro';
import Container from '../ui/Container.astro';
import Icon from '../ui/Icon.astro';
import { socialProfiles } from '../../config/social.js';

const year = new Date().getFullYear();
const whatsapp = whatsAppUrl();
const mapsUrl = googleMapsLink();

const socialLinks = socialProfiles;
---

<footer class="footer" id="footer">
  <Container size="wide">
    <div class="footer__top">
      <div class="footer__brand">
        <p class="footer__name">{site.name}</p>
        <p class="footer__tagline">
          Casa vacacional en Ica, Perú. Piscina, jardín y una casa completa para tu grupo, cerca
          del oasis de Huacachina.
        </p>
      </div>

      <div class="footer__cta">
        <p class="footer__cta-text">¿Quieres reservar tus fechas?</p>
        <Button href={bookingHref} variant="light" size="md" icon="arrow-right">
          {bookingLabel}
        </Button>
      </div>
    </div>

    <div class="footer__grid">
      <nav class="footer__column" aria-labelledby="footer-explorar">
        <h2 class="footer__title" id="footer-explorar">Explorar</h2>
        <ul class="footer__list" role="list">
          {mainNav.map((item) => <li><a href={withBase(item.href)}>{item.label}</a></li>)}
          {secondaryNav.map((item) => <li><a href={withBase(item.href)}>{item.label}</a></li>)}
        </ul>
      </nav>

      <div class="footer__column">
        <h2 class="footer__title">Contacto</h2>
        <ul class="footer__list" role="list">
          {
            site.contact.phone && (
              <li>
                <a href={`tel:${site.contact.phone.replace(/\s/g, '')}`}>{site.contact.phone}</a>
              </li>
            )
          }
          {
            site.contact.email && (
              <li>
                <a href={`mailto:${site.contact.email}`}>{site.contact.email}</a>
              </li>
            )
          }
          {
            whatsapp && (
              <li>
                <a href={whatsapp} target="_blank" rel="noopener noreferrer">
                  Escribir por WhatsApp
                </a>
              </li>
            )
          }
          {site.contact.hours && <li class="footer__muted">{site.contact.hours}</li>}
          <li>
            <a href={withBase(bookingHref)}>Solicitar reserva</a>
          </li>
        </ul>
      </div>

      <div class="footer__column">
        <h2 class="footer__title">Ubicación</h2>
        <address class="footer__address">{formattedAddress()}</address>
        <p class="footer__muted footer__address-note">
          Dirección exacta al confirmar la reserva.
        </p>
        {
          mapsUrl && (
            <a class="footer__map" href={mapsUrl} target="_blank" rel="noopener noreferrer">
              <Icon name="map-pin" size={15} />
              Ver en Google Maps
            </a>
          )
        }

        {
          socialLinks.length > 0 && (
            <ul class="footer__social" role="list">
              {socialLinks.map((link) => (
                <li>
                  <a
                    href={link.url}
                    target="_blank"
                    rel="noopener noreferrer"
                    aria-label={`${link.network} de ${site.name} (se abre en una pestaña nueva)`}
                  >
                    <Icon name={link.icon} size={18} />
                  </a>
                </li>
              ))}
            </ul>
          )
        }
      </div>
    </div>

    <div class="footer__bottom">
      <p class="footer__copy">
        © <span data-current-year>{year}</span> {site.name} · Ica, Perú. Todos los derechos
        reservados.
      </p>
      <ul class="footer__legal" role="list">
        {legalNav.map((item) => <li><a href={withBase(item.href)}>{item.label}</a></li>)}
      </ul>
    </div>
  </Container>
</footer>

{/* El año se fija en el build; esto lo mantiene al día sin recompilar. */}
<script is:inline>
  document.querySelectorAll('[data-current-year]').forEach((el) => {
    el.textContent = String(new Date().getFullYear());
  });
</script>

<style>
  .footer {
    padding-block: var(--section-space-sm) var(--space-2xl);
    background-color: var(--color-surface-deep);
    color: var(--color-text-inverse);
    border-block-start: 1px solid var(--color-border-inverse);
  }

  .footer__top {
    display: flex;
    flex-wrap: wrap;
    align-items: flex-end;
    justify-content: space-between;
    gap: var(--space-xl);
    padding-block-end: var(--space-xl);
    border-block-end: 1px solid var(--color-border-inverse);
  }

  .footer__name {
    font-family: var(--font-heading);
    font-size: clamp(2.25rem, 1.6rem + 2.4vw, 3.5rem);
    font-weight: var(--weight-heading);
    line-height: 1;
    letter-spacing: var(--tracking-tight);
  }

  .footer__tagline {
    margin-block-start: var(--space-sm);
    max-width: 40ch;
    font-size: var(--text-body-sm);
    line-height: var(--leading-normal);
    color: var(--color-text-inverse-muted);
  }

  .footer__cta {
    display: flex;
    flex-direction: column;
    align-items: flex-start;
    gap: var(--space-sm);
  }

  .footer__cta-text {
    font-size: var(--text-body-sm);
    color: var(--color-text-inverse-muted);
  }

  .footer__grid {
    display: grid;
    gap: var(--space-2xl);
    padding-block: var(--space-2xl);
  }

  .footer__title {
    font-family: var(--font-body);
    font-size: var(--text-2xs);
    font-weight: var(--weight-semibold);
    letter-spacing: var(--tracking-widest);
    text-transform: uppercase;
    color: var(--color-primary-light);
    margin-block-end: var(--space-md);
  }

  .footer__list {
    display: flex;
    flex-direction: column;
    gap: var(--space-2xs);
    list-style: none;
    margin: 0;
    padding: 0;
    font-size: var(--text-body-sm);
  }

  /* Los enlaces del pie mantienen un área táctil holgada sin separar
     visualmente la columna. */
  .footer__list a {
    display: inline-block;
    padding-block: 0.45rem;
  }

  .footer__list a,
  .footer__map {
    color: var(--color-text-inverse);
    text-decoration: none;
  }

  .footer__list a:hover,
  .footer__map:hover {
    color: var(--color-primary-light);
  }

  .footer__muted,
  .footer__address {
    font-size: var(--text-body-sm);
    color: var(--color-text-inverse-muted);
    line-height: var(--leading-normal);
  }

  .footer__address-note {
    margin-block-start: var(--space-2xs);
    font-size: var(--text-sm);
  }

  .footer__map {
    display: inline-flex;
    align-items: center;
    gap: 0.4rem;
    margin-block-start: var(--space-md);
    font-size: var(--text-sm);
  }

  .footer__social {
    display: flex;
    gap: var(--space-sm);
    list-style: none;
    margin-block-start: var(--space-lg);
    padding: 0;
  }

  .footer__social a {
    display: grid;
    place-items: center;
    width: 2.75rem;
    height: 2.75rem;
    border: 1px solid var(--color-border-inverse);
    border-radius: var(--radius-pill);
    color: var(--color-text-inverse);
    transition: border-color var(--duration-fast) var(--ease-out),
      color var(--duration-fast) var(--ease-out);
  }

  .footer__social a:hover {
    border-color: var(--color-primary-light);
    color: var(--color-primary-light);
  }

  .footer__bottom {
    display: flex;
    flex-direction: column;
    gap: var(--space-md);
    padding-block-start: var(--space-lg);
    border-block-start: 1px solid var(--color-border-inverse);
    font-size: var(--text-sm);
    color: var(--color-text-inverse-muted);
  }

  .footer__legal {
    display: flex;
    flex-wrap: wrap;
    gap: var(--space-md);
    list-style: none;
    margin: 0;
    padding: 0;
  }

  .footer__legal a {
    display: inline-block;
    /* Área táctil cómoda en móvil sin separar visualmente los enlaces. */
    padding-block: 0.75rem;
    color: var(--color-text-inverse-muted);
    text-decoration: none;
  }

  .footer__legal a:hover {
    color: var(--color-text-inverse);
  }

  @media (min-width: 48rem) {
    .footer__grid {
      grid-template-columns: repeat(3, minmax(0, 1fr));
    }

    .footer__bottom {
      flex-direction: row;
      align-items: center;
      justify-content: space-between;
    }
  }

  @media (min-width: 64rem) {
    .footer__grid {
      grid-template-columns: 1.2fr 1fr 1.2fr;
      gap: var(--space-4xl);
    }
  }
</style>
