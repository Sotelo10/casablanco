# =============================================================================
# CASA LEBLANC · VARIABLES DE ENTORNO
# =============================================================================
# Copia este archivo como `.env` y rellena lo que vayas necesitando:
#
#     cp .env.example .env
#
# El sitio funciona con todas las variables vacías. Cada integración se activa
# sola en cuanto encuentra su configuración; ninguna requiere tocar código.
#
# IMPORTANTE — cuándo se leen
# -----------------------------------------------------------------------------
# El sitio se compila a HTML estático, así que los valores se incrustan durante
# `npm run build`. Si cambias una variable, vuelve a compilar (o reinicia
# `npm run dev`): no basta con recargar el navegador.
#
# IMPORTANTE — qué es público
# -----------------------------------------------------------------------------
# Todo lo que empieza por PUBLIC_ acaba dentro del HTML y del JavaScript que
# recibe el visitante. Es correcto para las claves de más abajo, que están
# pensadas para eso, y nunca debe usarse para un secreto.
#
# `.env` está en `.gitignore`: no lo subas al repositorio. En producción se
# configuran estas mismas variables en el panel del proveedor de hosting.
# =============================================================================


# -----------------------------------------------------------------------------
# Dominio del sitio  ·  obligatorio antes de desplegar
# -----------------------------------------------------------------------------
# Se usa para las URL canónicas, Open Graph, el sitemap y robots.txt.
# Sin barra final. En desarrollo puedes dejar el valor de ejemplo.
SITE_URL=https://www.example.com


# -----------------------------------------------------------------------------
# Supabase  ·  opcional (necesario para que el formulario envíe de verdad)
# -----------------------------------------------------------------------------
# Panel de Supabase → Project Settings → API.
#
#   PUBLIC_SUPABASE_URL       "Project URL"           https://xxxx.supabase.co
#   PUBLIC_SUPABASE_ANON_KEY  clave "anon" / "public"  (la larga, empieza por eyJ)
#
# Las dos son públicas por diseño: quien protege los datos son las políticas RLS
# que crea `supabase/schema.sql`. Con `anon` sólo se puede leer el contenido
# público y CREAR solicitudes de reserva; nunca leerlas, editarlas ni borrarlas.
#
# Mientras estén vacías, el formulario avisa de que todavía no está conectado y
# ofrece WhatsApp. Nunca simula un envío correcto.
#
# NO añadas aquí la clave `service_role`. El proyecto no la usa en ninguna parte
# y no debe existir en un archivo que se lee durante el build del cliente.
PUBLIC_SUPABASE_URL=
PUBLIC_SUPABASE_ANON_KEY=


# -----------------------------------------------------------------------------
# Google Maps  ·  opcional
# -----------------------------------------------------------------------------
# Clave de la Maps Embed API. Restríngela por dominio (referrer HTTP) en la
# consola de Google: al ser pública, esa restricción es su única protección.
# Sin ella, la página de ubicación muestra un enlace a Google Maps en lugar del
# mapa incrustado. Requiere además coordenadas en `src/config/site.ts`.
PUBLIC_GOOGLE_MAPS_API_KEY=


# -----------------------------------------------------------------------------
# Google Analytics  ·  opcional
# -----------------------------------------------------------------------------
# Identificador de medición, formato G-XXXXXXXXXX.
# Vacío = no se carga ningún script de analítica y la página de cookies lo
# refleja automáticamente.
PUBLIC_GA_ID=


# -----------------------------------------------------------------------------
# Sólo para regenerar tipos  ·  opcional, nunca se usa en el sitio
# -----------------------------------------------------------------------------
# Identificador del proyecto de Supabase (el `xxxx` de la Project URL). Lo lee
# `npm run types:supabase` para volver a generar `src/lib/supabase/types.ts`
# cuando cambies el esquema. No forma parte del build ni llega al navegador.
SUPABASE_PROJECT_ID=
